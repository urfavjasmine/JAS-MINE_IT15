@model JAS_MINE_IT15.Models.Entities.Invoice
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Submit Proof of Payment";
    Layout = null;

    var fullName = Context?.Session?.GetString("FullName") ?? "User";
    var barangayName = ViewBag.BarangayName as string ?? "Your Barangay";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --brand:        #1a3a5c;
            --brand-mid:    #1e4d7a;
            --brand-light:  #2563ab;
            --accent:       #16a34a;
            --surface:      #f8fafc;
            --card-bg:      #ffffff;
            --text-dark:    #0f172a;
            --text-muted:   #64748b;
            --border:       #e2e8f0;
            --radius-lg:    12px;
            --radius-md:    10px;
            --radius-sm:    8px;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: var(--text-dark);
            margin: 0;
            min-height: 100vh;
        }

        /* --- Navbar --- */
        .navbar-custom {
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 0;
            margin-bottom: 2rem;
        }
        .nav-logo { height: 40px; }
        .nav-brand { font-weight: 800; font-size: 1.2rem; color: var(--brand); text-decoration: none; }
        .nav-user { font-size: 0.9rem; color: var(--text-muted); }
        .nav-logout { font-size: 0.9rem; color: var(--text-dark); font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px; }

        /* --- Header --- */
        .page-header { text-align: center; margin-bottom: 2.5rem; }
        .page-title { font-weight: 800; font-size: 2rem; color: var(--brand); margin-bottom: 0.4rem; }
        .page-subtitle { color: var(--text-muted); font-size: 1rem; }

        .form-wrapper { max-width: 680px; margin: 0 auto; padding-bottom: 5rem; }

        /* --- Summary Card --- */
        .summary-card {
            background: #f1f5f9;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            margin-bottom: 2rem;
        }
        .summary-header { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--brand); margin-bottom: 1.25rem; font-size: 1.05rem; }
        .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .summary-label { font-size: 0.82rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
        .summary-value { font-weight: 600; font-size: 0.95rem; }
        .summary-amount { font-size: 1.4rem; font-weight: 800; color: #0f172a; }
        .status-badge { background: #fee2e2; color: #991b1b; padding: 4px 12px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
        .status-pending { background: #fef3c7; color: #92400e; }

        /* --- Form Card --- */
        .form-card {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 2.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
        }
        .section-name { font-weight: 700; font-size: 1.2rem; margin-bottom: 0.3rem; }
        .section-desc { color: var(--text-muted); font-size: 0.88rem; margin-bottom: 2rem; }

        .form-label { font-weight: 600; font-size: 0.88rem; margin-bottom: 0.6rem; }
        .form-control, .form-select {
            border-radius: var(--radius-sm);
            padding: 0.75rem 1rem;
            border: 1px solid var(--border);
            font-size: 0.92rem;
            background-color: #ffffff;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--brand-light);
            box-shadow: 0 0 0 3px rgba(37,99,171,0.08);
        }

        /* --- Custom Upload Area --- */
        .upload-area {
            border: 2px dashed var(--border);
            border-radius: var(--radius-md);
            padding: 2.5rem 1.5rem;
            text-align: center;
            transition: all 0.2s;
            cursor: pointer;
            background: #fcfdfe;
            position: relative;
        }
        .upload-area:hover, .upload-area.dragover { border-color: var(--brand-light); background: #f8fafc; }
        .upload-icon { font-size: 2.2rem; color: var(--text-muted); margin-bottom: 1rem; display: block; }
        .upload-text { font-weight: 600; font-size: 0.92rem; color: #334155; margin-bottom: 4px; }
        .upload-hint { font-size: 0.8rem; color: var(--text-muted); }
        #proofFile { position: absolute; width: 100%; height: 100%; top:0; left:0; opacity: 0; cursor: pointer; }

        /* preview */
        #file-preview { margin-top: 1rem; display: none; align-items: center; gap: 10px; background: #f1f5f9; padding: 10px; border-radius: 8px; font-size: 0.85rem; }

        .btn-submit {
            background: #1a3a5c;
            color: #ffffff;
            border: none;
            width: 100%;
            padding: 0.9rem;
            border-radius: var(--radius-sm);
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 2rem;
            transition: all 0.2s;
        }
        .btn-submit:hover { background: #112a44; transform: translateY(-1px); }

        /* --- Chat Support Widget --- */
        .chat-support-btn {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 56px;
            height: 56px;
            background: var(--brand);
            color: white;
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(26,58,92,0.35);
            transition: all 0.2s;
            z-index: 1000;
        }
        .chat-support-btn:hover { transform: scale(1.1); background: #112a44; }

        .chat-panel {
            position: fixed;
            bottom: 90px;
            right: 24px;
            width: 340px;
            background: white;
            border-radius: var(--radius-lg);
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            z-index: 1001;
            display: none;
            overflow: hidden;
        }
        .chat-panel.open { display: block; }

        .chat-header {
            background: var(--brand);
            color: white;
            padding: 1rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .chat-header-title { font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: 8px; }
        .chat-close { background: none; border: none; color: white; font-size: 1.25rem; cursor: pointer; opacity: 0.8; }
        .chat-close:hover { opacity: 1; }

        .chat-body { padding: 1.25rem; max-height: 300px; overflow-y: auto; }
        .chat-message { background: #f1f5f9; padding: 12px 16px; border-radius: 12px; margin-bottom: 12px; font-size: 0.9rem; line-height: 1.5; }
        .chat-message.support { background: #e0f2fe; }

        .chat-input-area { padding: 1rem; border-top: 1px solid var(--border); display: flex; gap: 8px; }
        .chat-input { flex: 1; border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; font-size: 0.9rem; }
        .chat-input:focus { outline: none; border-color: var(--brand-light); }
        .chat-send { background: var(--brand); color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; }
        .chat-send:hover { background: #112a44; }

    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar-custom">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                <img src="/images/jasmine-logo.png" class="nav-logo" alt="Logo" />
                <span class="nav-brand">JAS-MINE</span>
            </a>
            <div class="d-flex align-items-center gap-4">
                <span class="nav-user"><i class="bi bi-person-circle me-1"></i> Welcome, <strong>@fullName</strong></span>
                <a href="@Url.Action("Logout", "Home")" class="nav-logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1 class="page-title">Submit Proof of Payment</h1>
            <p class="page-subtitle">Upload your payment receipt for verification</p>
        </div>

        <div class="form-wrapper">
            
            <!-- Invoice Summary -->
            <div class="summary-card">
                <div class="summary-header">
                    <i class="bi bi-file-earmark-text"></i> Invoice Summary
                </div>
                <div class="summary-grid">
                    <div>
                        <div class="summary-label">Plan:</div>
                        <div class="summary-value">@Model.Subscription?.Plan?.Name</div>
                    </div>
                    <div>
                        <div class="summary-label">Amount Due:</div>
                        <div class="summary-amount">₱@string.Format("{0:N0}", Model.Amount)</div>
                    </div>
                    <div>
                        <div class="summary-label">Barangay:</div>
                        <div class="summary-value">@barangayName</div>
                    </div>
                    <div>
                        <div class="summary-label">Status:</div>
                        <div>
                            <span class="status-badge status-pending">Pending Payment</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Online Payment Option (Automated) -->
            <div class="summary-card" style="background: #eff6ff; border-color: #dbeafe; margin-bottom: 25px;">
                <div class="summary-header" style="color: #1e40af;">
                    <i class="bi bi-lightning-charge-fill"></i> Faster Option: Online Payment
                </div>
                <p class="small text-muted mb-3">Pay instantly using GCash or Credit/Debit Card. Your subscription will be activated automatically once payment is confirmed.</p>
                
                <!-- Payment Method Selection -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="payment-method-option selected" data-method="gcash" onclick="selectPaymentMethod('gcash')">
                            <div class="d-flex align-items-center gap-3">
                                <div class="payment-icon" style="background: #007dfe;">
                                    <i class="bi bi-wallet2"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">GCash</div>
                                    <div class="small text-muted">Primary Payment Method</div>
                                </div>
                            </div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="payment-method-option" data-method="card" onclick="selectPaymentMethod('card')">
                            <div class="d-flex align-items-center gap-3">
                                <div class="payment-icon" style="background: #1a3a5c;">
                                    <i class="bi bi-credit-card"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">Credit/Debit Card</div>
                                    <div class="small text-muted">Visa, Mastercard</div>
                                </div>
                            </div>
                            <i class="bi bi-check-circle-fill check-icon"></i>
                        </div>
                    </div>
                </div>
                
                <form id="onlinePaymentForm" asp-action="InitiateOnlinePayment" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="invoiceId" value="@Model.Id" />
                    <input type="hidden" name="paymentMethod" id="selectedPaymentMethod" value="gcash" />
                    <button type="submit" class="btn-submit" style="background: #0284c7; margin-top: 0; padding: 0.75rem;">
                        <span id="payBtnText">Pay with GCash</span> <i class="bi bi-arrow-right"></i>
                    </button>
                </form>
            </div>
            
            <style>
                .payment-method-option {
                    background: #fff;
                    border: 2px solid var(--border);
                    border-radius: var(--radius-md);
                    padding: 1rem 1.25rem;
                    cursor: pointer;
                    transition: all 0.2s;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }
                .payment-method-option:hover {
                    border-color: #94a3b8;
                }
                .payment-method-option.selected {
                    border-color: #0284c7;
                    background: #f0f9ff;
                }
                .payment-method-option .check-icon {
                    color: #0284c7;
                    font-size: 1.25rem;
                    display: none;
                }
                .payment-method-option.selected .check-icon {
                    display: block;
                }
                .payment-icon {
                    width: 42px;
                    height: 42px;
                    border-radius: 10px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 1.2rem;
                }
            </style>
            
            <script>
                function selectPaymentMethod(method) {
                    // Update hidden field
                    document.getElementById('selectedPaymentMethod').value = method;
                    
                    // Update UI
                    document.querySelectorAll('.payment-method-option').forEach(el => {
                        el.classList.remove('selected');
                    });
                    document.querySelector(`.payment-method-option[data-method="${method}"]`).classList.add('selected');
                    
                    // Update button text
                    const btnText = document.getElementById('payBtnText');
                    if (method === 'gcash') {
                        btnText.textContent = 'Pay with GCash';
                    } else if (method === 'card') {
                        btnText.textContent = 'Pay with Credit/Debit Card';
                    }
                }
            </script>

            <!-- Manual Payment Form (Image 7) -->
            <div class="form-card">
                <h2 class="section-name">Payment Details</h2>
                <p class="section-desc">Fill in the details of your payment and upload proof</p>

                <form asp-action="UploadPaymentProof" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="invoiceId" value="@Model.Id" />

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label">Payment Method *</label>
                            <select name="paymentMethod" class="form-select" required>
                                <option value="">Select method</option>
                                <option value="GCash">GCash</option>
                                <option value="Maya">Maya</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="Cash">Cash / In-person</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Payment Date</label>
                            <input type="date" name="paymentDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Reference/Transaction Number *</label>
                        <input type="text" name="referenceNumber" class="form-control" placeholder="e.g. GCash Ref #1234567890" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Notes (Optional)</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Any additional notes..."></textarea>
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Proof of Payment (Screenshot/Photo) *</label>
                        <div class="upload-area" id="drop-zone">
                            <i class="bi bi-upload upload-icon"></i>
                            <div class="upload-text">Click to upload or drag & drop</div>
                            <div class="upload-hint">PNG, JPG, or PDF up to 5MB</div>
                            <input type="file" name="proofFile" id="proofFile" accept=".png,.jpg,.jpeg,.pdf" required />
                        </div>
                        
                        <div id="file-preview">
                            <i class="bi bi-file-earmark-check text-success fs-5"></i>
                            <span id="file-name" class="fw-semibold"></span>
                            <button type="button" class="btn-close ms-auto small" onclick="clearFile()"></button>
                        </div>
                    </div>

                    @if (ViewBag.HasPending == true)
                    {
                        <div class="alert alert-warning mt-4 small">
                            <i class="bi bi-info-circle me-1"></i>
                            You already have a pending proof for this invoice. Submitting again will replace the previous one.
                        </div>
                    }

                    <button type="submit" class="btn-submit">
                        <i class="bi bi-upload"></i> Submit Proof of Payment
                    </button>
                    
                    <div class="text-center mt-3">
                        <a href="@Url.Action("MySubscription", "Home")" class="text-muted small text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> Back to My Subscription
                        </a>
                    </div>
                </form>
            </div>

            <div class="text-center mt-5 mb-4 text-muted small">
                &copy; @DateTime.Now.Year JAS-MINE. All rights reserved.
            </div>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script>
        const fileInput = document.getElementById('proofFile');
        const dropZone = document.getElementById('drop-zone');
        const preview = document.getElementById('file-preview');
        const fileNameSpan = document.getElementById('file-name');

        fileInput.addEventListener('change', function() {
            if (this.files && this.files[0]) {
                showPreview(this.files[0].name);
            }
        });

        // Drag and drop handlers
        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, e => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, e => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
            }, false);
        });

        dropZone.addEventListener('drop', e => {
            const dt = e.dataTransfer;
            const files = dt.files;
            fileInput.files = files;
            if (files.length > 0) {
                showPreview(files[0].name);
            }
        });

        function showPreview(name) {
            fileNameSpan.textContent = name;
            preview.style.display = 'flex';
            dropZone.style.display = 'none';
        }

        function clearFile() {
            fileInput.value = '';
            preview.style.display = 'none';
            dropZone.style.display = 'block';
        }
    </script>

    <!-- Chat Support Widget -->
    <button class="chat-support-btn" onclick="toggleChat()" title="Chat Support">
        <i class="bi bi-chat-dots-fill"></i>
    </button>

    <div class="chat-panel" id="chatPanel">
        <div class="chat-header">
            <div class="chat-header-title">
                <i class="bi bi-headset"></i> Support Chat
            </div>
            <button class="chat-close" onclick="toggleChat()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="chat-body" id="chatBody">
            <div class="chat-message support">
                <strong>JAS-MINE Support</strong><br>
                Hi! 👋 Need help with your payment? We're here to assist with any questions about invoices, payment methods, or verification.
            </div>
        </div>
        <div class="chat-input-area">
            <input type="text" class="chat-input" id="chatInput" placeholder="Type your message..." onkeypress="handleChatKeypress(event)" />
            <button class="chat-send" onclick="sendMessage()">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>

    <script>
        function toggleChat() {
            const panel = document.getElementById('chatPanel');
            panel.classList.toggle('open');
            if (panel.classList.contains('open')) {
                document.getElementById('chatInput').focus();
            }
        }

        function handleChatKeypress(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message) return;

            const chatBody = document.getElementById('chatBody');
            
            // Add user message
            const userMsg = document.createElement('div');
            userMsg.className = 'chat-message';
            userMsg.innerHTML = '<strong>You</strong><br>' + escapeHtml(message);
            chatBody.appendChild(userMsg);
            
            input.value = '';
            chatBody.scrollTop = chatBody.scrollHeight;

            // Auto-reply after short delay
            setTimeout(() => {
                const supportMsg = document.createElement('div');
                supportMsg.className = 'chat-message support';
                supportMsg.innerHTML = '<strong>JAS-MINE Support</strong><br>Thank you for your message! Our support team will get back to you shortly. You can also reach us at <strong>support@jasmine.gov.ph</strong>.';
                chatBody.appendChild(supportMsg);
                chatBody.scrollTop = chatBody.scrollHeight;
            }, 1000);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>
