@model JAS_MINE_IT15.Models.SelectPlanViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Choose Your Subscription Plan";
    Layout = null;

    var fullName = Context?.Session?.GetString("FullName") ?? "User";
    var plans = Model.Plans.ToList();
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --brand:        #1a3a5c;
            --brand-mid:    #1e4d7a;
            --brand-light:  #2563ab;
            --accent:       #16a34a;
            --surface:      #f8fafc;
            --card-bg:      #ffffff;
            --text-dark:    #0f172a;
            --text-muted:   #64748b;
            --border:       #e2e8f0;
            --radius-lg:    12px;
            --radius-md:    10px;
            --radius-sm:    8px;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: var(--text-dark);
            margin: 0;
            min-height: 100vh;
        }

        /* --- Navbar --- */
        .navbar-custom {
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 0;
            margin-bottom: 3rem;
        }
        .nav-logo { height: 40px; }
        .nav-brand { font-weight: 800; font-size: 1.2rem; color: var(--brand); text-decoration: none; }
        .nav-user { font-size: 0.9rem; color: var(--text-muted); }
        .nav-logout { font-size: 0.9rem; color: var(--text-dark); font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px; }

        /* --- Page Title --- */
        .page-header { text-align: center; margin-bottom: 3rem; }
        .page-title { font-weight: 800; font-size: 2.2rem; color: var(--brand); margin-bottom: 0.5rem; }
        .page-subtitle { color: var(--text-muted); font-size: 1.05rem; }

        /* --- Pending Badge --- */
        .pending-banner {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fff9eb;
            color: #d97706;
            padding: 8px 20px;
            border-radius: 999px;
            font-size: 0.88rem;
            font-weight: 600;
            margin: 1.5rem 0;
            border: 1px solid #fee2e2;
        }
        .dot { width: 8px; height: 8px; background: #fbbf24; border-radius: 50%; }

        /* --- Plan Cards --- */
        .plan-card {
            background: #ffffff;
            border: 2px solid #ffffff;
            border-radius: var(--radius-lg);
            padding: 2.5rem 2rem;
            height: 100%;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            display: flex;
            flex-direction: column;
        }
        .plan-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); }
        .plan-card.selected { border-color: var(--accent); box-shadow: 0 12px 30px rgba(22,163,74,0.12); }

        .plan-header { text-align: center; margin-bottom: 1.5rem; }
        .plan-name { font-weight: 700; font-size: 1.25rem; margin-bottom: 0.75rem; color: #1e293b; }
        .plan-price { font-size: 2.4rem; font-weight: 800; color: #0f172a; margin-bottom: 0; }
        .plan-period { font-size: 0.95rem; color: var(--text-muted); font-weight: 500; }

        .user-limit-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #f1f5f9;
            color: #475569;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 999px;
            margin-bottom: 1rem;
        }

        .plan-description {
            font-size: 0.88rem;
            color: var(--text-muted);
            margin-top: 0.75rem;
            line-height: 1.5;
        }

        .plan-features { list-style: none; padding: 0; margin: 1.5rem 0; flex-grow: 1; }
        .plan-feature-item { display: flex; align-items: start; gap: 10px; margin-bottom: 12px; font-size: 0.92rem; color: #475569; }
        .feature-check { color: var(--accent); font-size: 1rem; }

        .btn-get-started {
            width: 100%;
            padding: 0.75rem 1.5rem;
            border: 2px solid var(--brand);
            border-radius: var(--radius-sm);
            background: transparent;
            color: var(--brand);
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-get-started:hover {
            background: var(--brand);
            color: #ffffff;
        }
        .plan-card.selected .btn-get-started {
            background: var(--brand);
            color: #ffffff;
        }

        /* Popular Badge */
        .popular-badge {
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: #1a3a5c;
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 999px;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Selection Check */
        .selection-check {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 24px;
            height: 24px;
            background: var(--accent);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            opacity: 0;
            transform: scale(0.5);
            transition: all 0.2s;
        }
        .plan-card.selected .selection-check { opacity: 1; transform: scale(1); }

        /* --- Footer Button --- */
        .action-container { text-align: center; margin-top: 4rem; margin-bottom: 5rem; }
        .btn-proceed {
            background: #1a3a5c;
            color: white;
            border: none;
            padding: 0.9rem 2.5rem;
            font-weight: 700;
            border-radius: var(--radius-sm);
            font-size: 1.05rem;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s;
            box-shadow: 0 4px 15px rgba(26,58,92,0.25);
            text-decoration: none;
        }
        .btn-proceed:hover { background: #112a44; transform: scale(1.02); box-shadow: 0 6px 20px rgba(26,58,92,0.35); color: white; }
        .btn-proceed:disabled { background: #94a3b8; cursor: not-allowed; box-shadow: none; }

        /* --- Chat Support Widget --- */
        .chat-support-btn {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 56px;
            height: 56px;
            background: var(--brand);
            color: white;
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(26,58,92,0.35);
            transition: all 0.2s;
            z-index: 1000;
        }
        .chat-support-btn:hover { transform: scale(1.1); background: #112a44; }

        .chat-panel {
            position: fixed;
            bottom: 90px;
            right: 24px;
            width: 340px;
            background: white;
            border-radius: var(--radius-lg);
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            z-index: 1001;
            display: none;
            overflow: hidden;
        }
        .chat-panel.open { display: block; }

        .chat-header {
            background: var(--brand);
            color: white;
            padding: 1rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .chat-header-title { font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: 8px; }
        .chat-close { background: none; border: none; color: white; font-size: 1.25rem; cursor: pointer; opacity: 0.8; }
        .chat-close:hover { opacity: 1; }

        .chat-body { padding: 1.25rem; max-height: 300px; overflow-y: auto; }
        .chat-message { background: #f1f5f9; padding: 12px 16px; border-radius: 12px; margin-bottom: 12px; font-size: 0.9rem; line-height: 1.5; }
        .chat-message.support { background: #e0f2fe; }

        .chat-input-area { padding: 1rem; border-top: 1px solid var(--border); display: flex; gap: 8px; }
        .chat-input { flex: 1; border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; font-size: 0.9rem; }
        .chat-input:focus { outline: none; border-color: var(--brand-light); }
        .chat-send { background: var(--brand); color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; }
        .chat-send:hover { background: #112a44; }

    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar-custom">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                <img src="/images/jasmine-logo.png" class="nav-logo" alt="Logo" />
                <span class="nav-brand">JAS-MINE</span>
            </a>
            <div class="d-flex align-items-center gap-4">
                <span class="nav-user"><i class="bi bi-person-circle me-1"></i> Welcome, <strong>@fullName</strong></span>
                <a href="@Url.Action("Logout", "Home")" class="nav-logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1 class="page-title">Choose Your Subscription Plan</h1>
            <p class="page-subtitle">Select a plan to activate your barangay's access to JAS-MINE ERP.</p>
            
            @if (Model.HasActiveSubscription)
            {
                <div class="alert alert-info d-inline-flex align-items-center gap-2 mt-3" role="alert">
                    <i class="bi bi-info-circle"></i>
                    <span>You already have an active or pending subscription. Select a new plan to upgrade or renew.</span>
                </div>
            }
            else
            {
                <div class="pending-banner">
                    <span class="dot"></span>
                    Your account is pending — select a plan and pay to activate
                </div>
            }
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var plan in plans)
            {
                var isEnterprise = plan.Name.Contains("Enterprise");
                var features = (plan.Features ?? "").Split(new[] { ';', '\n' }, StringSplitOptions.RemoveEmptyEntries);

                <div class="col-12 col-md-4">
                    <div class="plan-card" data-plan-id="@plan.Id" onclick="selectPlan(this)">
                        
                        @if (isEnterprise)
                        {
                            <div class="popular-badge">
                                <i class="bi bi-star-fill"></i> Recommended
                            </div>
                        }

                        <div class="selection-check">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div class="plan-header">
                            <h3 class="plan-name">@plan.Name</h3>
                            <div class="user-limit-badge">
                                <i class="bi bi-people-fill"></i> Up to @plan.UserLimit users
                            </div>
                            <div class="plan-price">₱@string.Format("{0:N0}", plan.Price)</div>
                            <span class="plan-period">/@(plan.DurationMonths == 1 ? "month" : "year")</span>
                            <p class="plan-description">@plan.Description</p>
                        </div>

                        <ul class="plan-features">
                            @foreach (var feat in features)
                            {
                                <li class="plan-feature-item">
                                    <i class="bi bi-check-lg feature-check"></i>
                                    <span>@feat.Trim()</span>
                                </li>
                            }
                        </ul>

                        <div class="plan-cta mt-auto">
                            <button type="button" class="btn-get-started">Get Started</button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <form asp-action="SubscribeToPlan" method="post" id="subForm" class="action-container">
            @Html.AntiForgeryToken()
            <input type="hidden" name="planId" id="selectedPlanId" value="" />
            <button type="submit" class="btn-proceed" id="proceedBtn" disabled>
                Proceed to Payment <i class="bi bi-arrow-right"></i>
            </button>
        </form>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function selectPlan(card) {
            // Remove selection from all cards
            document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('selected'));
            
            // Add selection to clicked card
            card.classList.add('selected');
            
            // Update hidden input
            const planId = card.getAttribute('data-plan-id');
            document.getElementById('selectedPlanId').value = planId;
            
            // Enable button
            document.getElementById('proceedBtn').disabled = false;
        }
    </script>

    <!-- Chat Support Widget -->
    <button class="chat-support-btn" onclick="toggleChat()" title="Chat Support">
        <i class="bi bi-chat-dots-fill"></i>
    </button>

    <div class="chat-panel" id="chatPanel">
        <div class="chat-header">
            <div class="chat-header-title">
                <i class="bi bi-headset"></i> Support Chat
            </div>
            <button class="chat-close" onclick="toggleChat()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="chat-body" id="chatBody">
            <div class="chat-message support">
                <strong>JAS-MINE Support</strong><br>
                Hi! 👋 How can we help you today? For any questions about plans or payments, we're here to assist.
            </div>
        </div>
        <div class="chat-input-area">
            <input type="text" class="chat-input" id="chatInput" placeholder="Type your message..." onkeypress="handleChatKeypress(event)" />
            <button class="chat-send" onclick="sendMessage()">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>

    <script>
        function toggleChat() {
            const panel = document.getElementById('chatPanel');
            panel.classList.toggle('open');
            if (panel.classList.contains('open')) {
                document.getElementById('chatInput').focus();
            }
        }

        function handleChatKeypress(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message) return;

            const chatBody = document.getElementById('chatBody');
            
            // Add user message
            const userMsg = document.createElement('div');
            userMsg.className = 'chat-message';
            userMsg.innerHTML = '<strong>You</strong><br>' + escapeHtml(message);
            chatBody.appendChild(userMsg);
            
            input.value = '';
            chatBody.scrollTop = chatBody.scrollHeight;

            // Auto-reply after short delay
            setTimeout(() => {
                const supportMsg = document.createElement('div');
                supportMsg.className = 'chat-message support';
                supportMsg.innerHTML = '<strong>JAS-MINE Support</strong><br>Thank you for your message! Our support team will get back to you shortly. You can also reach us at <strong>support@jasmine.gov.ph</strong>.';
                chatBody.appendChild(supportMsg);
                chatBody.scrollTop = chatBody.scrollHeight;
            }, 1000);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>
