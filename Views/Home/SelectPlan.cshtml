@model JAS_MINE_IT15.Models.SelectPlanViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Choose Your Subscription Plan";
    Layout = null;

    var fullName = Context?.Session?.GetString("FullName") ?? "User";
    var plans = Model.Plans.ToList();
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --brand:        #1a3a5c;
            --brand-mid:    #1e4d7a;
            --brand-light:  #2563ab;
            --accent:       #16a34a;
            --surface:      #f8fafc;
            --card-bg:      #ffffff;
            --text-dark:    #0f172a;
            --text-muted:   #64748b;
            --border:       #e2e8f0;
            --radius-lg:    12px;
            --radius-md:    10px;
            --radius-sm:    8px;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: var(--text-dark);
            margin: 0;
            min-height: 100vh;
        }

        /* --- Navbar --- */
        .navbar-custom {
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            padding: 0.75rem 0;
            margin-bottom: 3rem;
        }
        .nav-logo { height: 40px; }
        .nav-brand { font-weight: 800; font-size: 1.2rem; color: var(--brand); text-decoration: none; }
        .nav-user { font-size: 0.9rem; color: var(--text-muted); }
        .nav-logout { font-size: 0.9rem; color: var(--text-dark); font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px; }

        /* --- Page Title --- */
        .page-header { text-align: center; margin-bottom: 3rem; }
        .page-title { font-weight: 800; font-size: 2.2rem; color: var(--brand); margin-bottom: 0.5rem; }
        .page-subtitle { color: var(--text-muted); font-size: 1.05rem; }

        /* --- Pending Badge --- */
        .pending-banner {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #fff9eb;
            color: #d97706;
            padding: 8px 20px;
            border-radius: 999px;
            font-size: 0.88rem;
            font-weight: 600;
            margin: 1.5rem 0;
            border: 1px solid #fee2e2;
        }
        .dot { width: 8px; height: 8px; background: #fbbf24; border-radius: 50%; }

        /* --- Plan Cards --- */
        .plan-card {
            background: #ffffff;
            border: 2px solid #ffffff;
            border-radius: var(--radius-lg);
            padding: 2.5rem 2rem;
            height: 100%;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(0,0,0,0.04);
            display: flex;
            flex-direction: column;
        }
        .plan-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(0,0,0,0.08); }
        .plan-card.selected { border-color: var(--accent); box-shadow: 0 12px 30px rgba(22,163,74,0.12); }

        .plan-header { text-align: center; margin-bottom: 1.5rem; }
        .plan-name { font-weight: 700; font-size: 1.25rem; margin-bottom: 0.75rem; color: #1e293b; }
        .plan-price { font-size: 2.4rem; font-weight: 800; color: #0f172a; margin-bottom: 0; }
        .plan-period { font-size: 0.95rem; color: var(--text-muted); font-weight: 500; }

        .plan-features { list-style: none; padding: 0; margin: 0; }
        .plan-feature-item { display: flex; align-items: start; gap: 10px; margin-bottom: 12px; font-size: 0.92rem; color: #475569; }
        .feature-check { color: var(--accent); font-size: 1rem; }

        /* Popular Badge */
        .popular-badge {
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            background: #1a3a5c;
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 999px;
            white-space: nowrap;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* Selection Check */
        .selection-check {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 24px;
            height: 24px;
            background: var(--accent);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            opacity: 0;
            transform: scale(0.5);
            transition: all 0.2s;
        }
        .plan-card.selected .selection-check { opacity: 1; transform: scale(1); }

        /* --- Footer Button --- */
        .action-container { text-align: center; margin-top: 4rem; margin-bottom: 5rem; }
        .btn-proceed {
            background: #1a3a5c;
            color: white;
            border: none;
            padding: 0.9rem 2.5rem;
            font-weight: 700;
            border-radius: var(--radius-sm);
            font-size: 1.05rem;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s;
            box-shadow: 0 4px 15px rgba(26,58,92,0.25);
            text-decoration: none;
        }
        .btn-proceed:hover { background: #112a44; transform: scale(1.02); box-shadow: 0 6px 20px rgba(26,58,92,0.35); color: white; }
        .btn-proceed:disabled { background: #94a3b8; cursor: not-allowed; box-shadow: none; }

    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar-custom">
        <div class="container d-flex justify-content-between align-items-center">
            <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                <img src="/images/jasmine-logo.png" class="nav-logo" alt="Logo" />
                <span class="nav-brand">JAS-MINE</span>
            </a>
            <div class="d-flex align-items-center gap-4">
                <span class="nav-user">Welcome, @fullName</span>
                <a asp-action="Logout" class="nav-logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h1 class="page-title">Choose Your Subscription Plan</h1>
            <p class="page-subtitle">Select a plan to activate your barangay's access to JAS-MINE ERP.</p>
            
            @if (Model.HasActiveSubscription)
            {
                <div class="alert alert-info d-inline-flex align-items-center gap-2 mt-3" role="alert">
                    <i class="bi bi-info-circle"></i>
                    <span>You already have an active or pending subscription. Select a new plan to upgrade or renew.</span>
                </div>
            }
            else
            {
                <div class="pending-banner">
                    <span class="dot"></span>
                    Your account is pending — select a plan and pay to activate
                </div>
            }
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var plan in plans)
            {
                var isStandard = plan.Name.Contains("Standard");
                var isEnterprise = plan.Name.Contains("Enterprise");
                var features = (plan.Features ?? "").Split(new[] { ';', '\n' }, StringSplitOptions.RemoveEmptyEntries);

                <div class="col-12 col-md-4">
                    <div class="plan-card @(isEnterprise ? "selected" : "")" data-plan-id="@plan.Id" onclick="selectPlan(this)">
                        
                        @if (isStandard)
                        {
                            <div class="popular-badge">
                                <i class="bi bi-star-fill"></i> Most Popular
                            </div>
                        }

                        <div class="selection-check">
                            <i class="bi bi-check-lg"></i>
                        </div>

                        <div class="plan-header">
                            <h3 class="plan-name">@plan.Name</h3>
                            <div class="plan-price">₱@string.Format("{0:N0}", plan.Price)</div>
                            <span class="plan-period">/@(plan.DurationMonths == 1 ? "month" : "year")</span>
                        </div>

                        <ul class="plan-features">
                            @foreach (var feat in features)
                            {
                                <li class="plan-feature-item">
                                    <i class="bi bi-check-lg feature-check"></i>
                                    <span>@feat.Trim()</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        <form asp-action="SubscribeToPlan" method="post" id="subForm" class="action-container">
            @Html.AntiForgeryToken()
            <input type="hidden" name="planId" id="selectedPlanId" value="@(plans.FirstOrDefault(p => p.Name.Contains("Enterprise"))?.Id)" />
            <button type="submit" class="btn-proceed" id="proceedBtn">
                Proceed to Payment <i class="bi bi-arrow-right"></i>
            </button>
        </form>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function selectPlan(card) {
            // Remove selection from all cards
            document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('selected'));
            
            // Add selection to clicked card
            card.classList.add('selected');
            
            // Update hidden input
            const planId = card.getAttribute('data-plan-id');
            document.getElementById('selectedPlanId').value = planId;
            
            // Enable button
            document.getElementById('proceedBtn').disabled = false;
        }
    </script>
</body>
</html>
