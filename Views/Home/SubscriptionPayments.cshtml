@model JAS_MINE_IT15.Models.SubscriptionPaymentsViewModel
@{
    ViewData["Title"] = "Subscription Payments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    private string BadgeClass(string s)
    {
        s = (s ?? "").Trim();
        if (s == "Paid" || s == "Approved") return "bg-success bg-opacity-10 text-success border border-success-subtle px-3";
        if (s == "Pending") return "bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle px-3";
        if (s == "PendingVerification") return "bg-warning bg-opacity-10 text-warning border border-warning-subtle px-3";
        if (s == "Rejected") return "bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3";
        return "bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3";
    }
    private string StatusDisplay(string s)
    {
        if (s == "PendingVerification") return "Pending Verification";
        return s;
    }
    private string Peso(decimal amount) => "₱" + string.Format("{0:N0}", amount);
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="fw-bold mb-1">Subscription Payments</h2>
        <div class="text-muted">Payments are recorded automatically when a barangay completes payment via PayMongo.</div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card text-center">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-primary">@Model.TotalPayments</div>
                <div class="text-muted small">Total Payments</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-success">@Peso(Model.TotalCollected)</div>
                <div class="text-muted small">Total Collected</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center" style="cursor:pointer;" onclick="filterByStatus('PendingVerification')">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-warning">@Model.PendingVerificationCount</div>
                <div class="text-muted small">Awaiting Verification</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center" style="cursor:pointer;" onclick="filterByStatus('Approved')">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-success">@Model.ApprovedCount</div>
                <div class="text-muted small">Approved</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center" style="cursor:pointer;" onclick="filterByStatus('Rejected')">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-danger">@Model.RejectedCount</div>
                <div class="text-muted small">Rejected</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center" style="cursor:pointer;" onclick="filterByStatus('Failed')">
            <div class="card-body py-3">
                <div class="fs-3 fw-bold text-danger">@Model.FailedCount</div>
                <div class="text-muted small">Failed</div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Payments</span>
        @if (!string.IsNullOrWhiteSpace(Model.StatusFilter))
        {
            <a href="@Url.Action("SubscriptionPayments", new { q = Model.SearchQuery })" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i>Clear Filter
            </a>
        }
    </div>
    <div class="card-body">

        <!-- Status Tabs -->
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link @(string.IsNullOrWhiteSpace(Model.StatusFilter) ? "active" : "")" 
                   href="@Url.Action("SubscriptionPayments", new { q = Model.SearchQuery })">All</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.StatusFilter == "PendingVerification" ? "active" : "")" 
                   href="@Url.Action("SubscriptionPayments", new { q = Model.SearchQuery, status = "PendingVerification" })">
                    <i class="bi bi-clock-history me-1"></i>Pending Verification
                    @if (Model.PendingVerificationCount > 0)
                    {
                        <span class="badge bg-warning text-dark ms-1">@Model.PendingVerificationCount</span>
                    }
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.StatusFilter == "Approved" ? "active" : "")" 
                   href="@Url.Action("SubscriptionPayments", new { q = Model.SearchQuery, status = "Approved" })">Approved</a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.StatusFilter == "Rejected" ? "active" : "")" 
                   href="@Url.Action("SubscriptionPayments", new { q = Model.SearchQuery, status = "Rejected" })">Rejected</a>
            </li>
        </ul>

        <!-- Search -->
        <form method="get" asp-action="SubscriptionPayments" class="mb-3">
            <input type="hidden" name="status" value="@Model.StatusFilter" />
            <input name="q" value="@Model.SearchQuery" class="form-control" placeholder="Search payments..." />
        </form>

        <div class="table-responsive border rounded">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Barangay</th>
                        <th>Plan</th>
                        <th>Amount</th>
                        <th class="d-none d-md-table-cell">Date</th>
                        <th class="d-none d-md-table-cell">Method</th>
                        <th>Status</th>
                        <th style="width: 170px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr class="@(p.Status == "PendingVerification" ? "table-warning" : "")"
                            data-id="@p.Id">
                            <td class="fw-semibold">@p.BarangayName</td>
                            <td>@p.PlanName</td>
                            <td>@Peso(p.Amount)</td>
                            <td class="d-none d-md-table-cell text-muted">@p.PaymentDate</td>
                            <td class="d-none d-md-table-cell text-muted">@p.PaymentMethod</td>
                            <td><span class="badge @BadgeClass(p.Status)">@StatusDisplay(p.Status)</span></td>
                            <td class="text-end">
                                @if (p.Status == "PendingVerification")
                                {
                                    <form method="post" asp-action="ApprovePayment" style="display:inline;">
                                        <input type="hidden" name="paymentId" value="@p.Id" />
                                        <input type="hidden" name="q" value="@Model.SearchQuery" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success" title="Approve Payment">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-action="RejectPayment" style="display:inline;">
                                        <input type="hidden" name="paymentId" value="@p.Id" />
                                        <input type="hidden" name="q" value="@Model.SearchQuery" />
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" title="Reject Payment">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning"
                                            data-bs-toggle="modal" data-bs-target="#archiveModal"
                                            data-id="@p.Id">
                                        Archive
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>


<!-- ARCHIVE MODAL -->
<div class="modal fade" id="archiveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="ArchivePayment">
                @Html.AntiForgeryToken()
                <input type="hidden" name="q" value="@Model.SearchQuery" />
                <input type="hidden" name="id" id="archive_id" />

                <div class="modal-header">
                    <h5 class="modal-title">Archive Payment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    Are you sure you want to archive this payment record?
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Archive</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter by status when clicking stat cards
        function filterByStatus(status) {
            const currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set('status', status);
            window.location.href = currentUrl.toString();
        }

        // Get badge class based on status
        function getBadgeClass(status) {
            if (status === "Paid" || status === "Approved") return "bg-success-subtle text-success border border-success-subtle";
            if (status === "PendingVerification") return "bg-warning-subtle text-warning border border-warning-subtle";
            if (status === "Pending") return "bg-secondary-subtle text-secondary border border-secondary-subtle";
            if (status === "Rejected") return "bg-danger-subtle text-danger border border-danger-subtle";
            return "bg-danger-subtle text-danger border border-danger-subtle";
        }

        // Format status for display
        function formatStatus(status) {
            if (status === "PendingVerification") return "Pending Verification";
            return status;
        }

        // Archive modal fill
        document.getElementById('archiveModal')?.addEventListener('show.bs.modal', function (event) {
            const btn = event.relatedTarget;
            document.getElementById('archive_id').value = btn.getAttribute('data-id');
        });
    </script>
}
