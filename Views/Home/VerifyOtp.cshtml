@model JAS_MINE_IT15.Models.VerifyOtpViewModel
@{
    Layout = null;
    ViewData["Title"] = "Verify Login Code";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JAS-MINE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons-1.11.3/font/bootstrap-icons.css" />

    <style>
        body {
            min-height: 100vh;
            margin: 0;
            background: #f3f5f7;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .otp-card {
            width: 100%;
            max-width: 480px;
            border: 0;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
        }

        .otp-card .card-body {
            padding: 28px;
        }

        .brand-logo {
            width: 82px;
            height: auto;
            margin-bottom: 10px;
        }

        .page-title {
            font-weight: 800;
            color: #173a63;
            margin-bottom: 4px;
        }

        .subtitle {
            color: #66788a;
            margin-bottom: 16px;
        }

        .otp-input {
            height: 48px;
            letter-spacing: 3px;
            font-size: 20px;
            font-weight: 700;
            text-align: center;
        }

        .btn-verify {
            height: 46px;
            font-weight: 700;
            background: #173a63;
            border-color: #173a63;
        }

        .btn-verify:hover {
            background: #0f2f55;
            border-color: #0f2f55;
        }

        .expiry-note {
            color: #6b7a90;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="card otp-card">
        <div class="card-body">
            <div class="text-center mb-3">
                <img src="~/images/jasmine-logo.png" class="brand-logo" alt="JAS-MINE" />
                <h3 class="page-title">Two-Factor Verification</h3>
                <p class="subtitle mb-0">Enter the code sent to <strong>@Model.MaskedEmail</strong></p>
            </div>

            <div asp-validation-summary="All" class="text-danger small mb-2"></div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="alert alert-success">@Model.SuccessMessage</div>
            }

            <form method="post" asp-action="VerifyOtp" asp-controller="Home" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-semibold">Verification or Recovery Code</label>
                    <input asp-for="Code" class="form-control otp-input" maxlength="32" autocomplete="one-time-code" placeholder="Enter 6-digit OTP or backup code" />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="mb-3 expiry-note">
                    This code expires in about @(Math.Max(1, (int)Math.Ceiling(Model.RemainingSeconds / 60.0))) minute(s).
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberDevice" class="form-check-input" />
                    <label asp-for="RememberDevice" class="form-check-label">Trust this device for 30 days</label>
                </div>

                <button type="submit" class="btn btn-primary btn-verify w-100 mb-3">Verify and Sign In</button>

                <a asp-action="Login" asp-controller="Home" class="btn btn-outline-secondary w-100">Back to Login</a>
            </form>

            <form method="post" asp-action="ResendOtp" asp-controller="Home" class="mb-3">
                @Html.AntiForgeryToken()
                <button id="resend-btn" type="submit" class="btn btn-outline-primary w-100" @(Model.CanResend ? "" : "disabled")>
                    Resend Code
                </button>
            </form>

            <div class="expiry-note text-center mb-3">
                Remaining resends: <strong>@Model.RemainingResends</strong>
                <span id="resend-countdown" data-seconds="@Model.ResendAvailableInSeconds">
                    @if (!Model.CanResend)
                    {
                        @: | Resend available in @Model.ResendAvailableInSeconds second(s)
                    }
                </span>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        (function () {
            var countdownEl = document.getElementById('resend-countdown');
            var resendBtn = document.getElementById('resend-btn');
            if (!countdownEl || !resendBtn) return;

            var remaining = parseInt(countdownEl.getAttribute('data-seconds') || '0', 10);
            if (isNaN(remaining) || remaining <= 0) {
                resendBtn.disabled = false;
                countdownEl.textContent = '';
                return;
            }

            resendBtn.disabled = true;
            var timer = setInterval(function () {
                remaining -= 1;
                if (remaining <= 0) {
                    clearInterval(timer);
                    resendBtn.disabled = false;
                    countdownEl.textContent = ' | You can request a new code now.';
                    return;
                }

                countdownEl.textContent = ' | Resend available in ' + remaining + ' second(s)';
            }, 1000);
        })();
    </script>
</body>
</html>
