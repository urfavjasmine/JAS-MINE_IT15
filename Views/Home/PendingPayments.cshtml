@model JAS_MINE_IT15.Models.PendingPaymentsViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Pending Payments";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var role = Context?.Session?.GetString("Role") ?? "";
}

@functions {
    private string Peso(decimal amount) => "₱" + string.Format("{0:N0}", amount);
}

<div class="d-flex flex-column gap-4">

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-shield-check me-2"></i>Payment Verification</h2>
            <div class="text-muted">Review and verify pending payment proofs submitted by barangays.</div>
        </div>
        <span class="badge bg-warning-subtle border border-warning-subtle text-warning px-3 py-2 fs-6">
            <i class="bi bi-hourglass-split me-1"></i> @Model.Payments.Count Pending
        </span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Payments.Any())
    {
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-check-circle fs-1 d-block mb-2 text-success"></i>
                <div class="fw-semibold">All caught up!</div>
                <div class="small">There are no pending payments to review.</div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header bg-white fw-bold d-flex align-items-center gap-2">
                <i class="bi bi-receipt-cutoff"></i> Pending Payment Proofs
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Barangay</th>
                                <th>Plan</th>
                                <th>Invoice #</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Reference</th>
                                <th>Date</th>
                                <th>Proof</th>
                                <th class="text-center" style="min-width:220px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Payments)
                            {
                                <tr>
                                    <td class="fw-semibold">@p.BarangayName</td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            @p.PlanName
                                        </span>
                                    </td>
                                    <td class="text-muted small font-monospace">@p.InvoiceNumber</td>
                                    <td class="fw-bold text-success">@Peso(p.Amount)</td>
                                    <td class="text-muted">@(string.IsNullOrEmpty(p.PaymentMethod) ? "—" : p.PaymentMethod)</td>
                                    <td class="text-muted small">@(string.IsNullOrEmpty(p.ReferenceNumber) ? "—" : p.ReferenceNumber)</td>
                                    <td class="text-muted">@p.PaymentDate</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(p.ProofUrl))
                                        {
                                            <a href="@p.ProofUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye me-1"></i>View
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No file</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex gap-2 justify-content-center">
                                            <!-- Approve -->
                                            <form asp-action="ApprovePayment" method="post" onsubmit="return confirm('Approve this payment from @p.BarangayName? Their subscription will be activated.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="paymentId" value="@p.PaymentId" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-lg me-1"></i>Approve
                                                </button>
                                            </form>

                                            <!-- Reject (opens modal) -->
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rejectModal-@p.PaymentId">
                                                <i class="bi bi-x-lg me-1"></i>Reject
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <!-- Reject Modal -->
                                <div class="modal fade" id="rejectModal-@p.PaymentId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="RejectPayment" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="paymentId" value="@p.PaymentId" />

                                                <div class="modal-header bg-danger-subtle">
                                                    <h6 class="modal-title fw-bold text-danger">
                                                        <i class="bi bi-x-octagon me-1"></i> Reject Payment
                                                    </h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>

                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <div class="small text-muted mb-1">Payment from</div>
                                                        <div class="fw-semibold">@p.BarangayName — @p.InvoiceNumber</div>
                                                        <div class="text-primary fw-bold">@Peso(p.Amount)</div>
                                                    </div>
                                                    <div class="mb-0">
                                                        <label class="form-label fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
                                                        <textarea name="rejectionReason" class="form-control" rows="3"
                                                                  required placeholder="Explain why this payment is being rejected..."
                                                                  maxlength="500"></textarea>
                                                        <div class="form-text">This will be visible to the barangay admin.</div>
                                                    </div>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                        <i class="bi bi-x-lg me-1"></i> Reject Payment
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
