@{
    ViewData["Title"] = "Privacy Policy - JAS-MINE";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-5">
            <h1 class="fw-bold mb-4">Privacy Policy</h1>
            <p class="text-muted mb-4">Last Updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>

            <h5>1. Introduction</h5>
            <p>Welcome to JAS-MINE ERP System. This Privacy Policy outlines how we collect, use, and protect your information when you use our centralized ERP-based Knowledge Management System designed for barangays.</p>

            <h5>2. Information We Collect</h5>
            <p>We may collect personal information such as names, email addresses, and roles when you or your barangay administrator create an account. We also store documents, policies, and operational knowledge uploaded to the system.</p>

            <h5>3. How We Use Your Information</h5>
            <p>The information collected is used exclusively to provide the JAS-MINE services to your barangay, including managing users, tracking audit logs, and facilitating knowledge sharing within the platform.</p>

            <h5>4. Data Security</h5>
            <p>We implement appropriate security measures to protect your data from unauthorized access, alteration, disclosure, or destruction. However, no internet-based service is 100% secure.</p>

            <h5>5. Contact Us</h5>
            <p>If you have any questions about this Privacy Policy, please contact us at support@jasmine.gov.ph.</p>
            
            <div class="mt-5">
                <a href="javascript:history.back()" class="btn btn-outline-primary"><i class="bi bi-arrow-left"></i> Back</a>
            </div>
        </div>
    </div>
</div>
