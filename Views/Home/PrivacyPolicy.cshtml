@{
    ViewData["Title"] = "Privacy Policy - JAS-MINE";
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f1f5fb;
            color: #0f172a;
            min-height: 100vh;
        }
        /* Top nav bar */
        .policy-nav {
            background: linear-gradient(135deg, #1a3a6e 0%, #0f6cbd 100%);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            gap: 14px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 12px rgba(15,107,189,0.2);
        }
        .policy-nav .brand { color: white; font-weight: 800; font-size: 18px; letter-spacing: -0.5px; }
        .policy-nav .badge-pill {
            background: rgba(255,255,255,0.18);
            color: white;
            padding: 4px 12px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 600;
        }
        .policy-nav .back-btn {
            margin-left: auto;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.25);
            color: white;
            padding: 7px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background 0.2s;
        }
        .policy-nav .back-btn:hover { background: rgba(255,255,255,0.28); color: white; }

        /* Hero */
        .policy-hero {
            background: linear-gradient(135deg, #1a3a6e 0%, #0f6cbd 100%);
            color: white;
            padding: 56px 32px 80px;
            text-align: center;
        }
        .policy-hero .icon-wrap {
            width: 72px; height: 72px;
            background: rgba(255,255,255,0.15);
            border-radius: 20px;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 32px;
            margin-bottom: 20px;
        }
        .policy-hero h1 { font-size: 36px; font-weight: 800; margin-bottom: 10px; }
        .policy-hero p { opacity: 0.8; font-size: 15px; }

        /* Content card */
        .policy-card {
            max-width: 860px;
            margin: -40px auto 60px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 12px 48px rgba(15,107,189,0.10);
            overflow: hidden;
        }
        .policy-card-body { padding: 44px 52px; }
        .section-block {
            display: flex;
            gap: 20px;
            padding: 24px 0;
            border-bottom: 1px solid #f0f4fa;
        }
        .section-block:last-child { border-bottom: none; }
        .section-num {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, #1a3a6e, #0f6cbd);
            color: white;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800;
            font-size: 15px;
            flex-shrink: 0;
            margin-top: 3px;
        }
        .section-block h5 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: #0f1e3c; }
        .section-block p { font-size: 14px; color: #475569; line-height: 1.75; margin: 0; }
        .policy-footer {
            background: #f8faff;
            border-top: 1px solid #e8eef8;
            padding: 24px 52px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }
        .policy-footer small { color: #94a3b8; font-size: 13px; }
        @@media (max-width: 600px) {
            .policy-card-body { padding: 28px 20px; }
            .policy-footer { padding: 20px; }
            .policy-hero { padding: 40px 20px 70px; }
            .policy-hero h1 { font-size: 26px; }
        }
    </style>
</head>
<body>
    <!-- Top Navigation -->
    <nav class="policy-nav">
        <div class="icon-brand">
            <img src="~/images/jaslogo.png" alt="JAS-MINE" style="height:32px;" onerror="this.style.display='none'" />
        </div>
        <div class="brand">JAS-MINE</div>
        <span class="badge-pill">ERP System</span>
        <a href="@Url.Action("LandingPage", "Home")" class="back-btn">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </nav>

    <!-- Hero -->
    <div class="policy-hero">
        <div class="icon-wrap"><i class="bi bi-shield-lock"></i></div>
        <h1>Privacy Policy</h1>
        <p>Last updated: @DateTime.Now.ToString("MMMM dd, yyyy") &nbsp;&bull;&nbsp; Effective immediately</p>
    </div>

    <!-- Content -->
    <div class="container px-3">
        <div class="policy-card">
            <div class="policy-card-body">

                <div class="section-block">
                    <div class="section-num">1</div>
                    <div>
                        <h5>Introduction</h5>
                        <p>Welcome to JAS-MINE ERP System. This Privacy Policy outlines how we collect, use, and protect your information when you use our centralized ERP-based Knowledge Management System designed for barangays in the Philippines. By accessing or using JAS-MINE, you agree to the practices described in this document.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">2</div>
                    <div>
                        <h5>Information We Collect</h5>
                        <p>We may collect personal information such as full names, email addresses, contact numbers, and user roles when a barangay administrator creates or manages accounts within the system. We also store documents, policies, announcements, and operational knowledge uploaded by authorized barangay personnel.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">3</div>
                    <div>
                        <h5>How We Use Your Information</h5>
                        <p>All information collected is used exclusively to provide JAS-MINE services to your barangay. This includes managing user accounts, tracking audit logs for accountability, facilitating knowledge sharing and document management, and maintaining subscription records within the platform.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">4</div>
                    <div>
                        <h5>Data Security</h5>
                        <p>We implement industry-standard security measures including role-based access control, encrypted connections, and audit logging to protect your data from unauthorized access, alteration, disclosure, or destruction. Access to sensitive data is strictly limited to authenticated and authorized users only.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">5</div>
                    <div>
                        <h5>Data Retention</h5>
                        <p>We retain your data for as long as your barangay maintains an active subscription with JAS-MINE. Upon request or subscription termination, data may be exported or permanently deleted in accordance with our data retention policy and applicable laws.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">6</div>
                    <div>
                        <h5>Contact Us</h5>
                        <p>If you have any questions, concerns, or requests regarding this Privacy Policy or your personal data, please reach out to us at <strong>support@jasmine.gov.ph</strong>. We aim to respond to all inquiries within 5 business days.</p>
                    </div>
                </div>

            </div>
            <div class="policy-footer">
                <small>&copy; @DateTime.Now.Year JAS-MINE ERP System. All rights reserved.</small>
                <a href="@Url.Action("TermsOfUse", "Home")" style="font-size:13px; color:#0f6cbd;">View Terms of Use &rarr;</a>
            </div>
        </div>
    </div>
</body>
</html>
