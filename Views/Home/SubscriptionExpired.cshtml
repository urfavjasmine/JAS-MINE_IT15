@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Subscription Expired";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var role = Context?.Session?.GetString("Role") ?? "";
    var barangayName = Context?.Session?.GetString("Barangay") ?? "Your Barangay";
    var isAdmin = role == "barangay_admin";
}

<div class="d-flex flex-column align-items-center justify-content-center" style="min-height: 60vh;">
    <div class="card shadow-sm border-danger" style="max-width: 560px; width: 100%;">
        <div class="card-body text-center p-5">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-danger mb-3">Subscription Expired</h2>
            <p class="text-muted mb-2">
                The subscription for <strong>@barangayName</strong> has expired.
            </p>
            <p class="text-muted mb-4">
                You cannot access system features until your subscription is renewed.
                Please contact your Barangay Administrator or subscribe to a new plan.
            </p>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                @if (isAdmin)
                {
                    <a href="@Url.Action("SelectPlan", "Home")" class="btn btn-primary">
                        <i class="bi bi-arrow-repeat me-1"></i> Renew Subscription
                    </a>
                }
                <a href="@Url.Action("MySubscription", "Home")" class="btn btn-outline-secondary">
                    <i class="bi bi-eye me-1"></i> View Subscription Details
                </a>
            </div>
        </div>
    </div>
</div>
