@model JAS_MINE_IT15.Models.MfaRecoveryCodesViewModel
@{
    ViewData["Title"] = "MFA Recovery Codes";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h3 class="mb-3">MFA Recovery Codes</h3>
                    <p class="text-muted">Recovery codes can be used if you cannot access your OTP email.</p>

                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                    {
                        <div class="alert alert-success">@Model.SuccessMessage</div>
                    }

                    <div class="mb-3">
                        <strong>Remaining recovery codes:</strong> @Model.RemainingCodes
                    </div>

                    <form asp-action="RegenerateMfaRecoveryCodes" asp-controller="Home" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">Generate New Recovery Codes</button>
                    </form>

                    @if (Model.NewlyGeneratedCodes.Count > 0)
                    {
                        <div class="alert alert-warning">
                            Save these codes now. They will not be shown again.
                        </div>

                        <div class="bg-light border rounded p-3 mb-3">
                            <ul class="mb-0">
                                @foreach (var code in Model.NewlyGeneratedCodes)
                                {
                                    <li><code>@code</code></li>
                                }
                            </ul>
                        </div>
                    }

                    <a asp-action="Settings" asp-controller="Home" asp-route-tab="security" class="btn btn-outline-secondary">Back to Security Settings</a>
                </div>
            </div>
        </div>
    </div>
</div>
