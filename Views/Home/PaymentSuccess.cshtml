@model dynamic
@{
    ViewData["Title"] = "Payment Successful";
    Layout = null;
    
    var companyName = ViewBag.CompanyName as string ?? "Your Barangay";
    var planName = ViewBag.PlanName as string ?? "Subscription";
    var email = ViewBag.Email as string ?? "";
    var status = ViewBag.Status as string ?? "Active";
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JAS-MINE</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --brand: #1a3a5c;
            --brand-mid: #1e4d7a;
            --brand-light: #2563ab;
            --accent: #16a34a;
            --surface: #f8fafc;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --radius-lg: 16px;
            --radius-md: 12px;
            --radius-sm: 10px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #f0f4f8 0%, #e2e8f0 100%);
            color: var(--text-dark);
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .success-container {
            width: 100%;
            max-width: 480px;
        }

        .success-card {
            background: #fff;
            border-radius: var(--radius-lg);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
            padding: 3rem 2.5rem;
            text-align: center;
        }

        .check-icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1.5rem auto;
            animation: scaleIn 0.4s ease-out;
        }

        .check-icon i {
            font-size: 40px;
            color: #fff;
        }

        @@keyframes scaleIn {
            0% {
                transform: scale(0);
                opacity: 0;
            }
            50% {
                transform: scale(1.1);
            }
            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .success-title {
            font-size: 1.75rem;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
        }

        .success-subtitle {
            font-size: 1rem;
            color: var(--text-muted);
            margin-bottom: 2rem;
        }

        .info-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 2rem;
        }

        .info-table tr {
            border-bottom: 1px solid var(--border);
        }

        .info-table tr:last-child {
            border-bottom: none;
        }

        .info-table td {
            padding: 1rem 0;
            vertical-align: middle;
        }

        .info-label {
            text-align: left;
            font-size: 0.85rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
        }

        .info-value {
            text-align: right;
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-dark);
            word-break: break-word;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(22, 163, 74, 0.1);
            color: #16a34a;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 0.85rem;
            font-weight: 700;
            border: 1px solid rgba(22, 163, 74, 0.2);
        }

        .status-badge i {
            font-size: 0.75rem;
        }

        .btn-login {
            width: 100%;
            background: var(--brand);
            color: #fff;
            border: none;
            padding: 1rem 1.5rem;
            border-radius: var(--radius-sm);
            font-size: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
            transition: all 0.2s ease;
            margin-bottom: 1rem;
        }

        .btn-login:hover {
            background: #112a44;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(26, 58, 92, 0.3);
            color: #fff;
        }

        .btn-home {
            width: 100%;
            background: transparent;
            color: var(--text-dark);
            border: 1px solid var(--border);
            padding: 0.9rem 1.5rem;
            border-radius: var(--radius-sm);
            font-size: 0.95rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-home:hover {
            background: var(--surface);
            border-color: var(--text-muted);
            color: var(--text-dark);
        }

        .redirect-notice {
            margin-top: 1.5rem;
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .redirect-notice span {
            font-weight: 700;
            color: var(--brand);
        }

        @@media (max-width: 480px) {
            .success-card {
                padding: 2rem 1.5rem;
            }

            .success-title {
                font-size: 1.5rem;
            }

            .check-icon {
                width: 70px;
                height: 70px;
            }

            .check-icon i {
                font-size: 34px;
            }
        }
    </style>
</head>
<body>
    <div class="success-container">
        <div class="success-card">
            <div class="check-icon">
                <i class="bi bi-check-lg"></i>
            </div>

            <h1 class="success-title">Payment Successful!</h1>
            <p class="success-subtitle">Your JAS-MINE account has been activated.</p>

            <table class="info-table">
                <tr>
                    <td class="info-label">BARANGAY</td>
                    <td class="info-value">@companyName</td>
                </tr>
                <tr>
                    <td class="info-label">PLAN</td>
                    <td class="info-value">@planName</td>
                </tr>
                <tr>
                    <td class="info-label">LOGIN EMAIL</td>
                    <td class="info-value">@email</td>
                </tr>
                <tr>
                    <td class="info-label">STATUS</td>
                    <td class="info-value">
                        <span class="status-badge">
                            <i class="bi bi-circle-fill"></i>
                            @status
                        </span>
                    </td>
                </tr>
            </table>

            <a href="@Url.Action("Login", "Home")" class="btn-login">
                Go to Login
                <i class="bi bi-arrow-right"></i>
            </a>

            <a href="@Url.Action("LandingPage", "Home")" class="btn-home">
                Back to Home
            </a>

            <div class="redirect-notice">
                Redirecting to login in <span id="countdown">5</span> seconds...
            </div>
        </div>
    </div>

    <script>
        let seconds = 5;
        const countdownEl = document.getElementById('countdown');
        
        const interval = setInterval(() => {
            seconds--;
            countdownEl.textContent = seconds;
            
            if (seconds <= 0) {
                clearInterval(interval);
                window.location.href = '@Url.Action("Login", "Home")';
            }
        }, 1000);
    </script>
</body>
</html>
