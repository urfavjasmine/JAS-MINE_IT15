@model JAS_MINE_IT15.Models.AuditLogsViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Audit Logs";
    Layout = "~/Views/Shared/_Layout.cshtml";

  

    string ActionBadge(string a) => a switch
    {
        "Approve" or "Approved" => "badge rounded-pill bg-success bg-opacity-10 text-success border border-success-subtle",
        "Reject" or "Rejected" or "Delete" or "Deleted" or "Cancel" => "badge rounded-pill bg-danger bg-opacity-10 text-danger border border-danger-subtle",
        "Create" or "Created" or "Upload" or "Uploaded" or "Submit" or "Submitted" or "Post" or "Posted" => "badge rounded-pill bg-info bg-opacity-10 text-info border border-info-subtle",
        "Edit" or "Updated" or "StatusChange" => "badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning-subtle",
        "Login" or "Logout" => "badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary-subtle",
        "Archive" or "Archived" or "Restore" => "badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle",
        _ => "badge rounded-pill bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle"
    };
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.23/jspdf.plugin.autotable.min.js"></script>

<style>
    .page-wrap {
        padding: 18px;
    }

    .stat-card {
        border-radius: 12px;
    }

    .table-wrap {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        overflow: hidden;
    }

    .muted {
        color: #6b7280;
    }

    .action-btn {
        width: 38px;
        height: 38px;
        border-radius: 10px;
    }

    /* Print styles */
    @@media print {
        body * {
            visibility: hidden;
        }

        .print-area, .print-area * {
            visibility: visible;
        }

        .print-area {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .no-print {
            display: none !important;
        }

        .table-wrap {
            border: 1px solid #000;
            border-radius: 0;
        }

        .table th, .table td {
            border: 1px solid #ddd;
            padding: 8px;
        }

        .badge {
            border: 1px solid #333;
            padding: 2px 6px;
        }
    }
</style>

<div class="page-wrap">

    <!-- DEBUG PANEL - Remove after testing -->
    <div class="alert alert-warning mb-3" role="alert">
        <strong>DEBUG INFO:</strong><br/>
        Role: @Model.DebugRole<br/>
        BarangayId: @Model.DebugBarangayId<br/>
        Message: @Model.DebugMessage<br/>
        Logs Count: @Model.Logs.Count
    </div>

    <!-- Title + buttons -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h3 class="mb-0">Audit Logs</h3>
            <div class="muted">Track all system activities and changes.</div>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn" onclick="printLogs()" style="background:#6b7280; border-color:#6b7280; color:#fff; font-weight:600; border-radius:10px;">
                <i class="bi bi-printer me-2"></i>Print
            </button>
            <button type="button" class="btn" onclick="exportLogsToPdf()" style="background:#163a5f; border-color:#163a5f; color:#fff; font-weight:600; border-radius:10px;">
                <i class="bi bi-file-earmark-pdf me-2"></i>Export as PDF
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-3">
            <div class="card stat-card">
                <div class="card-body text-center py-4">
                    <div class="fs-2 fw-bold text-primary">@Model.TotalEntries</div>
                    <div class="small muted">Total Entries</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card stat-card">
                <div class="card-body text-center py-4">
                    <div class="fs-2 fw-bold text-success">@Model.Approvals</div>
                    <div class="small muted">Approvals</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card stat-card">
                <div class="card-body text-center py-4">
                    <div class="fs-2 fw-bold text-info">@Model.Creations</div>
                    <div class="small muted">Creations</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="card stat-card">
                <div class="card-body text-center py-4">
                    <div class="fs-2 fw-bold text-danger">@Model.RejectDelete</div>
                    <div class="small muted">Rejections/Deletions</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Activity Log card -->
    <div class="card">
        <div class="card-body">
            <div class="fw-semibold mb-3">Activity Log</div>

            <!-- Search + Module filter (KEEP this one, this is for AuditLogs filtering) -->
            <form method="get" action="@Url.Action("AuditLogs","Home")" class="d-flex flex-column flex-md-row gap-2 mb-3">
                <div class="input-group flex-grow-1">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input class="form-control" name="q" value="@Model.SearchQuery" placeholder="Search logs..." />
                </div>

                <select class="form-select" name="module" style="max-width: 220px;">
                    <option value="all" selected="@(Model.ModuleFilter == "all")">All Modules</option>
                    <option value="Authentication" selected="@(Model.ModuleFilter == "Authentication")">Authentication</option>
                    <option value="KnowledgeRepository" selected="@(Model.ModuleFilter == "KnowledgeRepository")">Knowledge Repository</option>
                    <option value="Policies" selected="@(Model.ModuleFilter == "Policies")">Policies & Procedures</option>
                    <option value="LessonsLearned" selected="@(Model.ModuleFilter == "LessonsLearned")">Lessons Learned</option>
                    <option value="BestPractices" selected="@(Model.ModuleFilter == "BestPractices")">Best Practices</option>
                    <option value="Announcements" selected="@(Model.ModuleFilter == "Announcements")">Announcements</option>
                    <option value="KnowledgeDiscussions" selected="@(Model.ModuleFilter == "KnowledgeDiscussions")">Knowledge Discussions</option>
                    <option value="Users" selected="@(Model.ModuleFilter == "Users")">User Management</option>
                    <option value="BarangaySubscriptions" selected="@(Model.ModuleFilter == "BarangaySubscriptions")">Subscriptions</option>
                    <option value="SubscriptionPayments" selected="@(Model.ModuleFilter == "SubscriptionPayments")">Payments</option>
                </select>

                <select class="form-select" name="action" style="max-width: 180px;">
                    <option value="all" selected="@(Model.ActionFilter == "all")">All Actions</option>
                    <option value="Login" selected="@(Model.ActionFilter == "Login")">Login</option>
                    <option value="Logout" selected="@(Model.ActionFilter == "Logout")">Logout</option>
                    <option value="Created" selected="@(Model.ActionFilter == "Created")">Created</option>
                    <option value="Updated" selected="@(Model.ActionFilter == "Updated")">Updated</option>
                    <option value="Deleted" selected="@(Model.ActionFilter == "Deleted")">Deleted</option>
                    <option value="Approved" selected="@(Model.ActionFilter == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(Model.ActionFilter == "Rejected")">Rejected</option>
                    <option value="Uploaded" selected="@(Model.ActionFilter == "Uploaded")">Uploaded</option>
                    <option value="Archived" selected="@(Model.ActionFilter == "Archived")">Archived</option>
                    <option value="Export" selected="@(Model.ActionFilter == "Export")">Export</option>
                </select>

                <button class="btn btn-primary" type="submit">Filter</button>
            </form>

            <div class="table-wrap">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th class="d-none d-md-table-cell">Module</th>
                            <th class="d-none d-lg-table-cell">Target</th>
                            <th style="width:110px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center muted py-4">No logs found.</td></tr>
                        }
                        else
                        {
                            foreach (var log in Model.Logs)
                            {
                                <tr class="clickable-row" style="cursor: pointer;"
                                    data-timestamp="@log.Timestamp" data-user="@log.User"
                                    data-action="@log.Action" data-module="@log.Module"
                                    data-target-name="@log.Target" data-ip="@log.Ip"
                                    onclick="openViewFromRow(this)">
                                    <td class="small muted text-nowrap">@log.Timestamp</td>
                                    <td class="fw-semibold">@log.User</td>
                                    <td><span class="@ActionBadge(log.Action)">@log.Action</span></td>
                                    <td class="d-none d-md-table-cell">
                                        <span class="badge rounded-pill border text-dark">@log.Module</span>
                                    </td>
                                    <td class="d-none d-lg-table-cell muted" style="max-width:260px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                                        @log.Target
                                    </td>
                                    <td class="text-end" onclick="event.stopPropagation();">
                                        <button class="btn btn-light action-btn" title="View"
                                                data-bs-toggle="modal" data-bs-target="#viewModal"
                                                data-timestamp="@log.Timestamp" data-user="@log.User"
                                                data-action="@log.Action" data-module="@log.Module"
                                                data-target-name="@log.Target" data-ip="@log.Ip"
                                                onclick="openView(this)">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        <button class="btn btn-light action-btn" title="Archive"
                                                data-bs-toggle="modal" data-bs-target="#archiveModal"
                                                onclick="openArchive('@log.Id')">
                                            <i class="bi bi-archive text-warning"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<!-- View Modal -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Log Entry Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body small">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="muted">Timestamp:</div>
                        <div class="font-monospace" id="vTimestamp">-</div>
                    </div>
                    <div class="col-6">
                        <div class="muted">User:</div>
                        <div id="vUser">-</div>
                    </div>
                    <div class="col-6">
                        <div class="muted">Action:</div>
                        <div id="vAction">-</div>
                    </div>
                    <div class="col-6">
                        <div class="muted">Module:</div>
                        <div id="vModule">-</div>
                    </div>
                    <div class="col-12">
                        <div class="muted">Target:</div>
                        <div id="vTarget">-</div>
                    </div>
                    <div class="col-12">
                        <div class="muted">IP Address:</div>
                        <div class="font-monospace" id="vIp">-</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Archive Modal -->
<div class="modal fade" id="archiveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="post" action="@Url.Action("ArchiveLog","Home")">
                @Html.AntiForgeryToken()
                <input type="hidden" id="archiveId" name="id" />
                <input type="hidden" name="q" value="@Model.SearchQuery" />
                <input type="hidden" name="module" value="@Model.ModuleFilter" />
                <input type="hidden" name="action" value="@Model.ActionFilter" />

                <div class="modal-header">
                    <h5 class="modal-title text-warning">Archive Log Entry</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    Are you sure you want to archive this log entry?
                </div>

                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                    <button class="btn btn-warning" type="submit">Archive</button>
                </div>
            </form>

        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function openView(btn) {
        document.getElementById('vTimestamp').innerText = btn.dataset.timestamp || '-';
        document.getElementById('vUser').innerText = btn.dataset.user || '-';
        document.getElementById('vAction').innerText = btn.dataset.action || '-';
        document.getElementById('vModule').innerText = btn.dataset.module || '-';
        document.getElementById('vTarget').innerText = btn.dataset.targetName || '-';
        document.getElementById('vIp').innerText = btn.dataset.ip || '-';
    }

    function openViewFromRow(row) {
        document.getElementById('vTimestamp').innerText = row.dataset.timestamp || '-';
        document.getElementById('vUser').innerText = row.dataset.user || '-';
        document.getElementById('vAction').innerText = row.dataset.action || '-';
        document.getElementById('vModule').innerText = row.dataset.module || '-';
        document.getElementById('vTarget').innerText = row.dataset.targetName || '-';
        document.getElementById('vIp').innerText = row.dataset.ip || '-';
        var modal = new bootstrap.Modal(document.getElementById('viewModal'));
        modal.show();
    }

    function openArchive(id) {
        document.getElementById('archiveId').value = id;
    }

    async { } // dummy for script context

    function exportLogsToPdf() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('l', 'pt'); // landscape, points

        doc.setFontSize(18);
        doc.text("Audit Logs Report", 40, 40);
        doc.setFontSize(11);
        doc.setTextColor(100);
        doc.text("Generated on: " + new Date().toLocaleString(), 40, 60);

        const table = document.querySelector(".table-wrap table tbody");
        const rows = table.querySelectorAll("tr");

        // Check if there are any actual data rows (not just the "No logs found" message)
        if (rows.length === 0 || (rows.length === 1 && rows[0].cells.length === 1)) {
            doc.setFontSize(12);
            doc.setTextColor(150);
            doc.text("No audit logs available to export.", 40, 100);
            doc.save("AuditLogs_" + new Date().toISOString().split('T')[0] + ".pdf");
            return;
        }

        // Extract data from visible rows
        const tableData = Array.from(rows).filter(tr => {
            // Filter out the "No logs found" row
            return tr.cells.length > 1;
        }).map(tr => {
            const cells = tr.querySelectorAll("td");
            return {
                timestamp: cells[0]?.innerText.trim() || '',
                user: cells[1]?.innerText.trim() || '',
                action: cells[2]?.innerText.trim() || '',
                module: cells[3]?.innerText.trim() || '',
                target: cells[4]?.innerText.trim() || ''
            };
        });

        if (tableData.length === 0) {
            doc.setFontSize(12);
            doc.setTextColor(150);
            doc.text("No audit logs available to export.", 40, 100);
            doc.save("AuditLogs_" + new Date().toISOString().split('T')[0] + ".pdf");
            return;
        }

        doc.autoTable({
            startY: 80,
            theme: 'striped',
            headStyles: { fillColor: [22, 58, 95] }, // #163a5f
            head: [['Timestamp', 'User', 'Action', 'Module', 'Target']],
            body: tableData.map(row => [
                row.timestamp,
                row.user,
                row.action,
                row.module,
                row.target
            ]),
            margin: { left: 40, right: 40 },
            styles: { fontSize: 9 }
        });

        doc.save("AuditLogs_" + new Date().toISOString().split('T')[0] + ".pdf");
    }

    function printLogs() {
        // Create a printable version of the table
        const tableWrap = document.querySelector(".table-wrap");
        const originalContent = document.body.innerHTML;
        
        const printContent = `
            <div style="padding: 20px;">
                <h2 style="margin-bottom: 5px;">Audit Logs Report</h2>
                <p style="color: #666; margin-bottom: 20px;">Generated on: ${new Date().toLocaleString()}</p>
                ${tableWrap.outerHTML}
            </div>
        `;
        
        document.body.innerHTML = printContent;
        window.print();
        document.body.innerHTML = originalContent;
        
        // Re-attach event listeners after restoring content
        location.reload();
    }
</script>
