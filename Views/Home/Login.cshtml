@model JAS_MINE_IT15.Models.LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Login";
    var recaptchaSiteKey = ViewData["RecaptchaSiteKey"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JAS-MINE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            background: #f3f5f7;
        }

        .login-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 28px;
            padding: 24px;
        }

        .branding {
            text-align: center;
        }

        .brand-logo {
            width: 120px;
            height: auto;
        }

        .brand-title {
            font-weight: 800;
            letter-spacing: .6px;
            color: #0f2747;
            margin-top: 14px;
            margin-bottom: 6px;
        }

        .brand-subtitle {
            color: #6c7a89;
            margin: 0;
        }

        .login-card {
            width: 100%;
            max-width: 560px;
            border: 0;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,.10);
        }

            .login-card .card-body {
                padding: 30px;
            }

        .welcome-title {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .welcome-sub {
            color: #6c7a89;
            margin-bottom: 18px;
        }

        .form-label {
            font-weight: 600;
            color: #1f2d3d;
        }

        .input-group-text {
            background: #f8f9fa;
            border-right: 0;
        }

        .form-control, .form-select {
            height: 46px;
            border-left: 0;
        }

            .form-control:focus, .form-select:focus {
                box-shadow: none;
            }

        .btn-primary-custom {
            background: #163a5f;
            border-color: #163a5f;
            color: #ffffff;
            height: 46px;
            font-weight: 600;
        }

            .btn-primary-custom:hover {
                background: #102d49;
                border-color: #102d49;
                color: #ffffff;
            }

        .forgot-link {
            text-decoration: none;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .footer-text {
            color: #7b8794;
            font-size: 12px;
            text-align: center;
            margin-top: 6px;
        }

        /* reCAPTCHA Widget Styling */
        .g-recaptcha {
            display: flex;
            justify-content: center;
            margin: 8px 0;
        }

        .recaptcha-error {
            border: 1px solid #dc3545;
            border-radius: 4px;
            padding: 8px 12px;
            background-color: #f8d7da;
            color: #721c24;
            font-size: 14px;
            margin-top: 8px;
        }

        .recaptcha-loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .recaptcha-spinner {
            display: inline-block;
            width: 12px;
            height: 12px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #163a5f;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 6px;
            vertical-align: middle;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
</head>

<body>
    <div class="login-shell">

        <div class="branding">
            <img src="~/images/jasmine-logo.png" class="brand-logo" alt="JAS-MINE" />
            <h2 class="brand-title">JAS-MINE</h2>
            <p class="brand-subtitle">Integrated ERP-Based Knowledge Management System</p>
        </div>

        <div class="card login-card">
            <div class="card-body">

                <div class="text-center mb-4">
                    <h3 class="welcome-title">Welcome Back</h3>
                    <div class="welcome-sub">Sign in to access your barangay portal</div>
                </div>

                @* SHOW VALIDATION ERRORS (so you can see why it stays) *@
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model?.ErrorMessage</div>
                }

                <form asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input asp-for="RecaptchaToken" type="hidden" id="recaptcha-token" />

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" id="passwordInput" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword" style="border-left: 0;">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    @if (Model?.CaptchaRequired ?? false)
                    {
                        <div class="mb-3">
                            <label class="form-label">Security Verification</label>
                            <div id="recaptcha-error" class="recaptcha-error" style="display: none;"></div>
                            @if (string.IsNullOrWhiteSpace(recaptchaSiteKey))
                            {
                                <div class="alert alert-danger small mb-0">
                                    <i class="bi bi-exclamation-circle"></i>
                                    Security verification is not configured. Please contact the administrator.
                                </div>
                            }
                            else
                            {
                                <div class="g-recaptcha" 
                                     data-sitekey="@recaptchaSiteKey"
                                     data-callback="RecaptchaCallbacks.onLoad"
                                     data-expired-callback="RecaptchaCallbacks.onExpire"
                                     data-error-callback="RecaptchaCallbacks.onError"></div>
                                <small class="text-muted">This site is protected by reCAPTCHA and the Google
                                    <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy Policy</a> and
                                    <a href="https://policies.google.com/terms" target="_blank" rel="noopener">Terms of Service</a> apply.
                                </small>
                            }
                        </div>
                    }

                    <button type="submit" class="btn btn-primary-custom w-100">
                        Sign In
                    </button>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <a class="forgot-link text-primary" asp-controller="Home" asp-action="ForgotPassword">
                            Forgot your password?
                        </a>
                        <a href="@Url.Action("LandingPage", "Home")" class="forgot-link text-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Home
                        </a>
                    </div>

                    <div class="text-center mt-4 footer-text">
                        © 2026 JAS-MINE. All rights reserved.
                    </div>
                </form>
  
            </div>
        </div>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (!string.IsNullOrWhiteSpace(recaptchaSiteKey))
    {
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    }
    <script>
        // ════════════════════════════════════════════════════════════════════════
        // Google reCAPTCHA v2 Integration - Login Form (Visible Checkbox)
        // ════════════════════════════════════════════════════════════════════════

        // Debug logging utility
        const RecaptchaDebug = {
            enabled: @((Model?.CaptchaRequired ?? false) ? "true" : "false"),
            log: function(message, data) {
                if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
                    console.log(`[reCAPTCHA v2] ${message}`, data || '');
                }
            },
            error: function(message, data) {
                console.error(`[reCAPTCHA v2 ERROR] ${message}`, data || '');
            }
        };

        // Initialize reCAPTCHA callback handlers
        window.RecaptchaCallbacks = {
            onLoad: function() {
                RecaptchaDebug.log('reCAPTCHA v2 widget loaded successfully');
            },
            onExpire: function() {
                RecaptchaDebug.log('reCAPTCHA token expired, user needs to re-verify');
                const errorDiv = document.getElementById('recaptcha-error');
                if (errorDiv) {
                    errorDiv.textContent = 'Your CAPTCHA verification has expired. Please complete it again.';
                    errorDiv.style.display = 'block';
                }
            },
            onError: function() {
                RecaptchaDebug.error('reCAPTCHA encountered an error');
                const errorDiv = document.getElementById('recaptcha-error');
                if (errorDiv) {
                    errorDiv.textContent = 'CAPTCHA verification failed. Please try again.';
                    errorDiv.style.display = 'block';
                }
            }
        };

        // ────────────────────────────────────────────────────────────────
        // Password visibility toggle
        // ────────────────────────────────────────────────────────────────
        document.getElementById('togglePassword')?.addEventListener('click', function (e) {
            e.preventDefault();
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        });

        // ────────────────────────────────────────────────────────────────
        // Form submission with reCAPTCHA v2 validation
        // ────────────────────────────────────────────────────────────────
        document.getElementById('loginForm')?.addEventListener('submit', function (e) {
            const captchaRequired = @((Model?.CaptchaRequired ?? false).ToString().ToLower());

            RecaptchaDebug.log('Form submit triggered. CAPTCHA required: ' + captchaRequired);

            // If CAPTCHA is not required, allow form submission
            if (!captchaRequired) {
                RecaptchaDebug.log('CAPTCHA not required, proceeding with login');
                return true;
            }

            // Validate reCAPTCHA is available
            if (typeof grecaptcha === 'undefined') {
                RecaptchaDebug.error('grecaptcha API not available');
                e.preventDefault();
                alert('reCAPTCHA API is not loaded. Please refresh the page and try again.');
                return false;
            }

            // Get the reCAPTCHA v2 response token
            const token = grecaptcha.getResponse();
            RecaptchaDebug.log('reCAPTCHA response obtained. Token length: ' + (token ? token.length : 0));

            // Validate token is present
            if (!token || token.trim() === '') {
                RecaptchaDebug.error('reCAPTCHA token is empty');
                e.preventDefault();
                
                // Show error message to user
                const errorDiv = document.getElementById('recaptcha-error');
                if (errorDiv) {
                    errorDiv.textContent = 'Please complete the CAPTCHA verification below.';
                    errorDiv.style.display = 'block';
                    errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
                } else {
                    alert('Please complete the CAPTCHA verification.');
                }
                return false;
            }

            // Set the token in the hidden input field
            const tokenInput = document.getElementById('recaptcha-token');
            tokenInput.value = token;
            RecaptchaDebug.log('Token set in hidden input field');

            // Show loading state
            const submitButton = this.querySelector('button[type="submit"]');
            if (submitButton) {
                const originalText = submitButton.innerHTML;
                submitButton.disabled = true;
                submitButton.innerHTML = '<span class="recaptcha-spinner"></span>Signing in...';
                
                // Reset on form error (in case server returns error)
                this.addEventListener('reset', function() {
                    submitButton.disabled = false;
                    submitButton.innerHTML = originalText;
                });
            }

            RecaptchaDebug.log('Form validation passed, submitting...');
            return true;
        });

        // ────────────────────────────────────────────────────────────────
        // Handle reCAPTCHA API ready state
        // ────────────────────────────────────────────────────────────────
        if (typeof grecaptcha !== 'undefined') {
            grecaptcha.ready(function() {
                RecaptchaDebug.log('grecaptcha.ready() callback executed');
            });
        } else if (@((Model?.CaptchaRequired ?? false).ToString().ToLower())) {
            // If CAPTCHA is required but API is not loaded, warn the user
            RecaptchaDebug.error('CAPTCHA is required but grecaptcha API is not loaded');
            const errorDiv = document.getElementById('recaptcha-error');
            if (errorDiv) {
                errorDiv.textContent = 'Security verification is loading. Please wait...';
                errorDiv.style.display = 'block';
            }
        }

        // ────────────────────────────────────────────────────────────────
        // Clear error messages when user interacts with form
        // ────────────────────────────────────────────────────────────────
        document.getElementById('loginForm')?.addEventListener('input', function() {
            const errorDiv = document.getElementById('recaptcha-error');
            if (errorDiv && errorDiv.textContent.includes('CAPTCHA')) {
                errorDiv.style.display = 'none';
            }
        });
    </script>

    @* REQUIRED for client-side validation *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
