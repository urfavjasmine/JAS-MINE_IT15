@model JAS_MINE_IT15.Models.LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Login";
    var recaptchaSiteKey = ViewData["RecaptchaSiteKey"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JAS-MINE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons-1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            background: #f3f5f7;
        }

        .login-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 28px;
            padding: 24px; 
        }

        .branding {
            text-align: center;
        }

        .brand-logo {
            width: 120px;
            height: auto;
        }

        .brand-title {
            font-weight: 800;
            letter-spacing: .6px;
            color: #0f2747;
            margin-top: 14px;
            margin-bottom: 6px;
        }

        .brand-subtitle {
            color: #6c7a89;
            margin: 0;
        }

        .login-card {
            width: 100%;
            max-width: 560px;
            border: 0;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,.10);
        }

            .login-card .card-body {
                padding: 30px;
            }

        .welcome-title {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .welcome-sub {
            color: #6c7a89;
            margin-bottom: 18px;
        }

        .form-label {
            font-weight: 600;
            color: #1f2d3d;
        }

        .input-group-text {
            background: #f8f9fa;
            border-right: 0;
        }

        .form-control, .form-select {
            height: 46px;
            border-left: 0;
        }

            .form-control:focus, .form-select:focus {
                box-shadow: none;
            }

        .btn-primary-custom {
            background: #163a5f;
            border-color: #163a5f;
            color: #ffffff;
            height: 46px;
            font-weight: 600;
        }

            .btn-primary-custom:hover {
                background: #102d49;
                border-color: #102d49;
                color: #ffffff;
            }

        .forgot-link {
            text-decoration: none;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .footer-text {
            color: #7b8794;
            font-size: 12px;
            text-align: center;
            margin-top: 6px;
        }

        /* reCAPTCHA Widget Styling */
        .g-recaptcha {
            display: flex;
            justify-content: center;
            margin: 8px 0;
        }

        .recaptcha-error {
            border: 1px solid #dc3545;
            border-radius: 4px;
            padding: 8px 12px;
            background-color: #f8d7da;
            color: #721c24;
            font-size: 14px;
            margin-top: 8px;
        }

        .recaptcha-loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .recaptcha-spinner {
            display: inline-block;
            width: 12px;
            height: 12px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #163a5f;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 6px;
            vertical-align: middle;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
</head>

<body>
    <div class="login-shell">

        <div class="branding">
            <img src="~/images/jasmine-logo.png" class="brand-logo" alt="JAS-MINE" />
            <h2 class="brand-title">JAS-MINE</h2>
            <p class="brand-subtitle">Integrated ERP-Based Knowledge Management System</p>
        </div>

        <div class="card login-card">
            <div class="card-body">

                <div class="text-center mb-4">
                    <h3 class="welcome-title">Welcome Back</h3>
                    <div class="welcome-sub">Sign in to access your barangay portal</div>
                </div>

                @* SHOW VALIDATION ERRORS (so you can see why it stays) *@
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model?.ErrorMessage</div>
                }

                <form asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input asp-for="RecaptchaToken" type="hidden" id="recaptcha-token" />

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" id="passwordInput" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword" style="border-left: 0;">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    @if (Model?.CaptchaRequired ?? false)
                    {
                        <div class="mb-3">
                            <label class="form-label">Security Verification</label>
                            <div id="recaptcha-error" class="recaptcha-error" style="display: none;"></div>
                            @if (string.IsNullOrWhiteSpace(recaptchaSiteKey))
                            {
                                <div class="alert alert-danger small mb-0">
                                    <i class="bi bi-exclamation-circle"></i>
                                    Security verification is not configured. Please contact the administrator.
                                </div>
                            }
                            else
                            {
                                <div class="g-recaptcha" 
                                     data-sitekey="@recaptchaSiteKey"
                                     data-callback="RecaptchaCallbacks.onLoad"
                                     data-expired-callback="RecaptchaCallbacks.onExpire"
                                     data-error-callback="RecaptchaCallbacks.onError"></div>
                                <small class="text-muted">This site is protected by reCAPTCHA and the Google
                                    <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Privacy Policy</a> and
                                    <a href="https://policies.google.com/terms" target="_blank" rel="noopener">Terms of Service</a> apply.
                                </small>
                            }
                        </div>
                    }

                    <button type="submit" class="btn btn-primary-custom w-100">
                        Sign In
                    </button>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <a class="forgot-link text-primary" asp-controller="Home" asp-action="ForgotPassword">
                            Forgot your password?
                        </a>
                        <a href="@Url.Action("LandingPage", "Home")" class="forgot-link text-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Home
                        </a>
                    </div>

                    <div class="text-center mt-4 footer-text">
                        © 2026 JAS-MINE. All rights reserved.
                    </div>
                </form>
  
            </div>
        </div>

    </div>

    <!-- ==================== SCRIPTS ==================== -->
    <!-- Load Bootstrap first (no jQuery dependency in v5) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Load jQuery and validation before custom scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Load reCAPTCHA API with callback safety -->
    @if (!string.IsNullOrWhiteSpace(recaptchaSiteKey))
    {
        <script src="https://www.google.com/recaptcha/api.js?onload=RecaptchaInit&render=explicit" async defer></script>
    }

    <!-- Main Login Script with proper error handling -->
    <script>
        (function() {
            'use strict';

            // ════════════════════════════════════════════════════════════════════════
            // DEBUG LOGGING UTILITY - Console logs in development only
            // ════════════════════════════════════════════════════════════════════════
            const RecaptchaDebug = {
                enabled: @((Model?.CaptchaRequired ?? false) ? "true" : "false"),
                log: function(message, data) {
                    if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
                        console.log(`[Login Debug] ${message}`, data || '');
                    }
                },
                error: function(message, data) {
                    console.error(`[Login ERROR] ${message}`, data || '');
                }
            };

            // ════════════════════════════════════════════════════════════════════════
            // RECAPTCHA INITIALIZATION - Safeguard for async loading
            // ════════════════════════════════════════════════════════════════════════
            window.RecaptchaInit = function() {
                RecaptchaDebug.log('reCAPTCHA API initialized and ready');
                if (window.RecaptchaReady && typeof window.RecaptchaReady === 'function') {
                    window.RecaptchaReady();
                }
            };

            // Define callbacks BEFORE reCAPTCHA script loads
            window.RecaptchaCallbacks = {
                onLoad: function() {
                    RecaptchaDebug.log('reCAPTCHA v2 widget loaded successfully');
                },
                onExpire: function() {
                    RecaptchaDebug.log('reCAPTCHA token expired');
                    const errorDiv = document.getElementById('recaptcha-error');
                    if (errorDiv) {
                        errorDiv.textContent = 'Your verification has expired. Please complete CAPTCHA again.';
                        errorDiv.style.display = 'block';
                    }
                },
                onError: function() {
                    RecaptchaDebug.error('reCAPTCHA API error occurred');
                    const errorDiv = document.getElementById('recaptcha-error');
                    if (errorDiv) {
                        errorDiv.textContent = 'CAPTCHA verification failed. Please try again.';
                        errorDiv.style.display = 'block';
                    }
                }
            };

            // ════════════════════════════════════════════════════════════════════════
            // PASSWORD VISIBILITY TOGGLE
            // ════════════════════════════════════════════════════════════════════════
            function initPasswordToggle() {
                try {
                    const toggleBtn = document.getElementById('togglePassword');
                    if (!toggleBtn) return;

                    toggleBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        const passwordInput = document.getElementById('passwordInput');
                        const toggleIcon = document.getElementById('toggleIcon');

                        if (!passwordInput || !toggleIcon) {
                            RecaptchaDebug.error('Password toggle elements not found');
                            return;
                        }

                        if (passwordInput.type === 'password') {
                            passwordInput.type = 'text';
                            toggleIcon.classList.remove('bi-eye');
                            toggleIcon.classList.add('bi-eye-slash');
                        } else {
                            passwordInput.type = 'password';
                            toggleIcon.classList.remove('bi-eye-slash');
                            toggleIcon.classList.add('bi-eye');
                        }
                    });
                } catch (error) {
                    RecaptchaDebug.error('Password toggle initialization failed', error);
                }
            }

            // ════════════════════════════════════════════════════════════════════════
            // FORM SUBMISSION HANDLER
            // ════════════════════════════════════════════════════════════════════════
            function initFormSubmit() {
                try {
                    const loginForm = document.getElementById('loginForm');
                    if (!loginForm) return;

                    loginForm.addEventListener('submit', function(e) {
                        const captchaRequired = @((Model?.CaptchaRequired ?? false).ToString().ToLower());
                        RecaptchaDebug.log('Form submit - CAPTCHA required: ' + captchaRequired);

                        // If CAPTCHA not required, allow submission
                        if (!captchaRequired) {
                            RecaptchaDebug.log('CAPTCHA not required, proceeding');
                            return true;
                        }

                        // Validate reCAPTCHA is available
                        if (typeof grecaptcha === 'undefined') {
                            RecaptchaDebug.error('grecaptcha API unavailable');
                            e.preventDefault();
                            alert('Security verification not loaded. Please refresh and try again.');
                            return false;
                        }

                        // Get reCAPTCHA response token
                        try {
                            const token = grecaptcha.getResponse();
                            RecaptchaDebug.log('reCAPTCHA token retrieved: ' + (token ? 'present' : 'empty'));

                            // Validate token exists
                            if (!token || token.trim() === '') {
                                RecaptchaDebug.error('reCAPTCHA token empty');
                                e.preventDefault();

                                const errorDiv = document.getElementById('recaptcha-error');
                                if (errorDiv) {
                                    errorDiv.textContent = 'Please complete the CAPTCHA verification.';
                                    errorDiv.style.display = 'block';
                                    errorDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
                                } else {
                                    alert('Please complete the CAPTCHA verification.');
                                }
                                return false;
                            }

                            // Set token in hidden input
                            const tokenInput = document.getElementById('recaptcha-token');
                            if (tokenInput) {
                                tokenInput.value = token;
                                RecaptchaDebug.log('Token set successfully');
                            } else {
                                RecaptchaDebug.error('Token input field not found');
                                return false;
                            }

                            // Show loading state
                            const submitBtn = loginForm.querySelector('button[type="submit"]');
                            if (submitBtn) {
                                const originalText = submitBtn.textContent;
                                submitBtn.disabled = true;
                                submitBtn.innerHTML = '<span class="recaptcha-spinner"></span>Signing in...';

                                // Store for potential error recovery
                                submitBtn.dataset.originalText = originalText;
                            }

                            RecaptchaDebug.log('Form validation complete, submitting');
                            return true;

                        } catch (error) {
                            RecaptchaDebug.error('reCAPTCHA token retrieval error', error);
                            e.preventDefault();
                            alert('An error occurred during verification. Please try again.');
                            return false;
                        }
                    });

                    // Clear errors on form input
                    loginForm.addEventListener('input', function() {
                        const errorDiv = document.getElementById('recaptcha-error');
                        if (errorDiv && errorDiv.textContent.includes('CAPTCHA')) {
                            errorDiv.style.display = 'none';
                        }
                    });

                } catch (error) {
                    RecaptchaDebug.error('Form submission initialization failed', error);
                }
            }

            // ════════════════════════════════════════════════════════════════════════
            // INITIALIZATION ON DOM READY
            // ════════════════════════════════════════════════════════════════════════
            function initializeLogin() {
                RecaptchaDebug.log('Initializing login page');
                
                // Initialize components
                initPasswordToggle();
                initFormSubmit();

                // Handle reCAPTCHA API readiness
                if (typeof grecaptcha !== 'undefined') {
                    try {
                        grecaptcha.ready(function() {
                            RecaptchaDebug.log('grecaptcha.ready() executed successfully');
                        });
                    } catch (error) {
                        RecaptchaDebug.error('grecaptcha.ready() error', error);
                    }
                } else if (@((Model?.CaptchaRequired ?? false).ToString().ToLower())) {
                    RecaptchaDebug.error('CAPTCHA required but API not available');
                    const errorDiv = document.getElementById('recaptcha-error');
                    if (errorDiv) {
                        errorDiv.textContent = 'Security verification is loading. Please wait...';
                        errorDiv.style.display = 'block';
                    }
                }

                RecaptchaDebug.log('Login initialization complete');
            }

            // Wait for DOM to be fully ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initializeLogin);
            } else {
                initializeLogin();
            }

        })();
    </script>
</body>
</html>
