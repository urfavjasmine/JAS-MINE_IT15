@model JAS_MINE_IT15.Models.LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
    ViewData["Title"] = "Login";
    var turnstileSiteKey = ViewData["TurnstileSiteKey"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - JAS-MINE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons-1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            background: #f3f5f7;
        }

        .login-shell {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 28px;
            padding: 24px; 
        }

        .branding {
            text-align: center;
        }

        .brand-logo {
            width: 120px;
            height: auto;
        }

        .brand-title {
            font-weight: 800;
            letter-spacing: .6px;
            color: #0f2747;
            margin-top: 14px;
            margin-bottom: 6px;
        }

        .brand-subtitle {
            color: #6c7a89;
            margin: 0;
        }

        .login-card {
            width: 100%;
            max-width: 560px;
            border: 0;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,.10);
        }

            .login-card .card-body {
                padding: 30px;
            }

        .welcome-title {
            font-weight: 700;
            margin-bottom: 6px;
        }

        .welcome-sub {
            color: #6c7a89;
            margin-bottom: 18px;
        }

        .form-label {
            font-weight: 600;
            color: #1f2d3d;
        }

        .input-group-text {
            background: #f8f9fa;
            border-right: 0;
        }

        .form-control, .form-select {
            height: 46px;
            border-left: 0;
        }

            .form-control:focus, .form-select:focus {
                box-shadow: none;
            }

        .btn-primary-custom {
            background: #163a5f;
            border-color: #163a5f;
            color: #ffffff;
            height: 46px;
            font-weight: 600;
        }

            .btn-primary-custom:hover {
                background: #102d49;
                border-color: #102d49;
                color: #ffffff;
            }

        .forgot-link {
            text-decoration: none;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .footer-text {
            color: #7b8794;
            font-size: 12px;
            text-align: center;
            margin-top: 6px;
        }

        /* Turnstile Widget Styling */
        .cf-turnstile {
            display: flex;
            justify-content: center;
            margin: 8px 0;
        }

        .turnstile-error {
            border: 1px solid #dc3545;
            border-radius: 4px;
            padding: 8px 12px;
            background-color: #f8d7da;
            color: #721c24;
            font-size: 14px;
            margin-top: 8px;
        }

        .turnstile-loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .turnstile-spinner {
            display: inline-block;
            width: 12px;
            height: 12px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #163a5f;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 6px;
            vertical-align: middle;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>

<body>
    <div class="login-shell">

        <div class="branding">
            <img src="~/images/jasmine-logo.png" class="brand-logo" alt="JAS-MINE" />
            <h2 class="brand-title">JAS-MINE</h2>
            <p class="brand-subtitle">Integrated ERP-Based Knowledge Management System</p>
        </div>

        <div class="card login-card">
            <div class="card-body">

                <div class="text-center mb-4">
                    <h3 class="welcome-title">Welcome Back</h3>
                    <div class="welcome-sub">Sign in to access your barangay portal</div>
                </div>

                @* SHOW VALIDATION ERRORS (so you can see why it stays) *@
                <div asp-validation-summary="All" class="text-danger small mb-2"></div>

                @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model?.ErrorMessage</div>
                }

                <form asp-action="Login" method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    <input asp-for="TurnstileToken" type="hidden" id="turnstile-token" />

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password" id="passwordInput" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword" style="border-left: 0;">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Security Verification</label>
                        <div id="turnstile-error" class="turnstile-error" style="display: none;"></div>
                        @if (string.IsNullOrWhiteSpace(turnstileSiteKey))
                        {
                            <div class="alert alert-danger small mb-0">
                                <i class="bi bi-exclamation-circle"></i>
                                Security verification is not configured. Please contact the administrator.
                            </div>
                        }
                        else
                        {
                            <div class="cf-turnstile"
                                 data-sitekey="@turnstileSiteKey"
                                 data-callback="TurnstileCallbacks.onSuccess"
                                 data-expired-callback="TurnstileCallbacks.onExpire"
                                 data-error-callback="TurnstileCallbacks.onError"></div>
                            <small class="text-muted">This site is protected by Cloudflare Turnstile.</small>
                        }
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100">
                        Sign In
                    </button>

                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <a class="forgot-link text-primary" asp-controller="Home" asp-action="ForgotPassword">
                            Forgot your password?
                        </a>
                        <a href="@Url.Action("LandingPage", "Home")" class="forgot-link text-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Home
                        </a>
                    </div>

                    <div class="text-center mt-4 footer-text">
                        © 2026 JAS-MINE. All rights reserved.
                    </div>
                </form>
  
            </div>
        </div>

    </div>

    <!-- ==================== SCRIPTS ==================== -->
    <!-- Load scripts in correct order -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <!-- Load Turnstile API -->
    @if (!string.IsNullOrWhiteSpace(turnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }

    <script>
        // Simple debug logging
        function debugLog(msg) {
            if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
                console.log('[Login] ' + msg);
            }
        }

        debugLog('Page ready');

        // Define Turnstile callbacks EARLY
        window.TurnstileCallbacks = {
            onSuccess: function(token) {
                debugLog('Turnstile token received');
                var tokenInput = document.getElementById('turnstile-token');
                if (tokenInput) {
                    tokenInput.value = token || '';
                }
            },
            onExpire: function() {
                debugLog('Turnstile token expired');
                var errorDiv = document.getElementById('turnstile-error');
                if (errorDiv) {
                    errorDiv.textContent = 'Your verification has expired. Please complete it again.';
                    errorDiv.style.display = 'block';
                }
                var tokenInput = document.getElementById('turnstile-token');
                if (tokenInput) {
                    tokenInput.value = '';
                }
            },
            onError: function() {
                debugLog('Turnstile error');
                var errorDiv = document.getElementById('turnstile-error');
                if (errorDiv) {
                    errorDiv.textContent = 'Verification failed. Please try again.';
                    errorDiv.style.display = 'block';
                }
            }
        };

        // Wait for DOM
        document.addEventListener('DOMContentLoaded', function() {
            debugLog('DOM loaded, initializing');

            // Password toggle
            var toggleBtn = document.getElementById('togglePassword');
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var pwd = document.getElementById('passwordInput');
                    var icon = document.getElementById('toggleIcon');
                    if (pwd.type === 'password') {
                        pwd.type = 'text';
                        icon.classList.remove('bi-eye');
                        icon.classList.add('bi-eye-slash');
                    } else {
                        pwd.type = 'password';
                        icon.classList.remove('bi-eye-slash');
                        icon.classList.add('bi-eye');
                    }
                });
            }

            // Form submission
            var form = document.getElementById('loginForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    if (typeof turnstile === 'undefined') {
                        debugLog('turnstile not available');
                        e.preventDefault();
                        alert('Security verification not loaded. Please refresh and try again.');
                        return false;
                    }

                    var tokenInput = document.getElementById('turnstile-token');
                    var token = tokenInput ? tokenInput.value : '';
                    if (!token) {
                        var responseInput = document.querySelector('input[name="cf-turnstile-response"]');
                        token = responseInput ? responseInput.value : '';
                    }

                    debugLog('Token: ' + (token ? 'present' : 'empty'));

                    if (!token || token.trim() === '') {
                        e.preventDefault();
                        var errorDiv = document.getElementById('turnstile-error');
                        if (errorDiv) {
                            errorDiv.textContent = 'Please complete the security verification.';
                            errorDiv.style.display = 'block';
                        }
                        return false;
                    }

                    if (tokenInput) {
                        tokenInput.value = token;
                    }

                    var btn = form.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<span class="turnstile-spinner"></span>Signing in...';
                    }

                    return true;
                });

                // Clear error on input
                form.addEventListener('input', function() {
                    var errorDiv = document.getElementById('turnstile-error');
                    if (errorDiv && errorDiv.style.display !== 'none') {
                        errorDiv.style.display = 'none';
                    }
                });
            }

            debugLog('Initialization complete');
        });
    </script>
</body>
</html>
