@using JAS_MINE_IT15.Models.Entities
@{
    ViewData["Title"] = "JAS-MINE – Barangay ERP System";
    Layout = null;
    var year = DateTime.Now.Year;
    var plans = (ViewBag.Plans as List<SubscriptionPlan>) ?? new List<SubscriptionPlan>();
    var planCount = plans.Count;
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="JAS-MINE is a centralized ERP-based Knowledge Management System designed to help barangays manage documents, policies, and operational knowledge efficiently and securely." />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        /* ── Root tokens ─────────────────────────────────── */
        :root {
            --brand:        #1a3a5c;
            --brand-mid:    #1e4d7a;
            --brand-light:  #2563ab;
            --accent:       #16a34a;
            --accent-hover: #15803d;
            --gold:         #f59e0b;
            --surface:      #f8fafc;
            --card-bg:      #ffffff;
            --text-dark:    #0f172a;
            --text-muted:   #64748b;
            --border:       #e2e8f0;
            --radius-lg:    20px;
            --radius-md:    14px;
            --radius-sm:    10px;
            --shadow-sm:    0 2px 8px rgba(0,0,0,.06);
            --shadow-md:    0 8px 24px rgba(0,0,0,.10);
            --shadow-lg:    0 20px 48px rgba(0,0,0,.14);
        }

        *, *::before, *::after { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--surface);
            color: var(--text-dark);
            margin: 0;
        }

        /* ── Navbar ──────────────────────────────────────── */
        .navbar-landing {
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(18px) saturate(180%);
            -webkit-backdrop-filter: blur(18px) saturate(180%);
            background: rgba(255,255,255,.88);
            border-bottom: 1px solid rgba(226,232,240,.8);
            padding: 0.6rem 0;
            transition: box-shadow .3s;
        }
        .navbar-landing.scrolled { box-shadow: 0 4px 20px rgba(0,0,0,.08); }

        .nav-logo-text {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--brand);
            letter-spacing: -.3px;
        }

        /* ── Hero ────────────────────────────────────────── */
        .hero {
            position: relative;
            min-height: 92vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: linear-gradient(135deg, #e8f4f8 0%, #d4e8f2 40%, #c5dde9 70%, #b8d4e3 100%);
        }

        /* decorative mesh gradient overlay */
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 70% at 70% 10%, rgba(37,99,171,.15) 0%, transparent 60%),
                radial-gradient(ellipse 50% 60% at 10% 80%, rgba(22,163,74,.08) 0%, transparent 55%);
            pointer-events: none;
        }

        /* animated grain */
        .hero-grain {
            position: absolute;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
            opacity: .3;
            pointer-events: none;
        }

        /* floating circles */
        .hero-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            animation: orbFloat 8s ease-in-out infinite;
        }
        .hero-orb-1 { width: 520px; height: 520px; background: rgba(37,99,171,.12); top: -120px; right: -80px; animation-delay: 0s; }
        .hero-orb-2 { width: 380px; height: 380px; background: rgba(22,163,74,.08); bottom: -100px; left: -60px; animation-delay: -4s; }
        .hero-orb-3 { width: 240px; height: 240px; background: rgba(245,158,11,.06); top: 30%; left: 55%; animation-delay: -2s; }

        @@keyframes orbFloat {
            0%, 100% { transform: translateY(0) scale(1); }
            50%       { transform: translateY(-30px) scale(1.04); }
        }

        .hero-content { position: relative; z-index: 1; }

        /* Hero logo with soft glow background */
        .hero-logo-wrapper {
            background: rgba(255,255,255,.85);
            border-radius: 24px;
            padding: 20px 28px;
            box-shadow: 0 8px 32px rgba(26,58,92,.12), 0 0 60px rgba(255,255,255,.6);
            backdrop-filter: blur(10px);
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .hero-logo-img {
            height: 100px;
            width: auto;
            object-fit: contain;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(26,58,92,.08);
            border: 1px solid rgba(26,58,92,.15);
            color: var(--brand);
            padding: 6px 18px;
            border-radius: 999px;
            font-size: .82rem;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
            backdrop-filter: blur(8px);
            margin-bottom: 1.6rem;
        }
        .hero-badge .dot { width: 7px; height: 7px; border-radius: 50%; background: #16a34a; box-shadow: 0 0 8px #16a34a; animation: pulse 2s infinite; }
        @@keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:.4;} }

        .hero h1 {
            font-size: clamp(2.2rem, 5.5vw, 4rem);
            font-weight: 900;
            line-height: 1.1;
            letter-spacing: -1.5px;
            color: var(--brand);
            margin-bottom: 1.25rem;
        }
        .hero h1 .highlight {
            background: linear-gradient(90deg, #2563ab 0%, #16a34a 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .hero-sub {
            font-size: 1.05rem;
            line-height: 1.75;
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto 2.2rem;
        }

        .btn-hero-primary {
            background: linear-gradient(135deg, var(--accent) 0%, #059669 100%);
            color: white;
            padding: 14px 32px;
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: 1rem;
            text-decoration: none;
            border: none;
            box-shadow: 0 4px 20px rgba(22,163,74,.40);
            transition: all .25s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(22,163,74,.50); color: white; }

        .btn-hero-ghost {
            background: rgba(26,58,92,.08);
            color: var(--brand);
            padding: 14px 32px;
            border-radius: var(--radius-sm);
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            border: 1.5px solid rgba(26,58,92,.20);
            backdrop-filter: blur(8px);
            transition: all .25s;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-hero-ghost:hover { background: rgba(26,58,92,.15); border-color: rgba(26,58,92,.35); color: var(--brand); transform: translateY(-2px); }

        /* scroll indicator */
        .scroll-cue {
            position: absolute;
            bottom: 32px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            color: rgba(26,58,92,.45);
            font-size: .72rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            animation: scrollBounce 2s ease-in-out infinite;
        }
        @@keyframes scrollBounce { 0%,100%{transform:translateX(-50%) translateY(0);} 50%{transform:translateX(-50%) translateY(6px);} }
        .scroll-cue i { font-size: 1.2rem; }

        /* ── Stats bar ───────────────────────────────────── */
        .stats-bar {
            background: white;
            border-bottom: 1px solid var(--border);
            padding: 2rem 0;
        }
        .stat-item { text-align: center; padding: 0.5rem 1rem; }
        .stat-number {
            font-size: 2rem;
            font-weight: 900;
            color: var(--brand);
            line-height: 1;
            letter-spacing: -1px;
        }
        .stat-label { font-size: .8rem; color: var(--text-muted); font-weight: 500; margin-top: 4px; letter-spacing: .3px; }
        .stat-divider { width: 1px; background: var(--border); height: 48px; align-self: center; }

        /* ── How it works ────────────────────────────────── */
        .steps-section { padding: 90px 0; background: var(--surface); }

        .step-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: linear-gradient(135deg, rgba(37,99,171,.1) 0%, rgba(22,163,74,.1) 100%);
            color: var(--brand-light);
            padding: 5px 14px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            margin-bottom: 1rem;
        }

        .step-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 2rem;
            height: 100%;
            transition: all .3s;
            position: relative;
            overflow: hidden;
        }
        .step-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--brand-light), var(--accent));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .35s;
        }
        .step-card:hover { box-shadow: var(--shadow-md); transform: translateY(-4px); border-color: transparent; }
        .step-card:hover::before { transform: scaleX(1); }

        .step-number {
            width: 40px; height: 40px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
            color: white;
            font-weight: 800;
            font-size: .95rem;
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 1rem;
            box-shadow: 0 4px 12px rgba(26,58,92,.25);
        }
        .step-card h5 { font-weight: 700; font-size: 1rem; margin-bottom: .5rem; }
        .step-card p { font-size: .88rem; color: var(--text-muted); line-height: 1.65; margin: 0; }

        /* ── Features ────────────────────────────────────── */
        .features-section { padding: 90px 0; background: white; }

        .section-eyebrow {
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: var(--brand-light);
            margin-bottom: .6rem;
        }
        .section-title {
            font-size: clamp(1.8rem, 3.5vw, 2.6rem);
            font-weight: 800;
            letter-spacing: -.8px;
            color: var(--text-dark);
            line-height: 1.15;
            margin-bottom: .8rem;
        }
        .section-sub { font-size: 1rem; color: var(--text-muted); max-width: 520px; line-height: 1.7; }

        .feature-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 2rem;
            height: 100%;
            transition: all .3s cubic-bezier(.25,.8,.25,1);
            position: relative;
            overflow: hidden;
        }
        .feature-card::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: var(--radius-lg);
            background: linear-gradient(135deg, rgba(37,99,171,.03) 0%, rgba(22,163,74,.03) 100%);
            opacity: 0;
            transition: opacity .3s;
        }
        .feature-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); border-color: rgba(37,99,171,.15); }
        .feature-card:hover::after { opacity: 1; }

        .feature-icon-wrap {
            width: 56px; height: 56px;
            border-radius: var(--radius-md);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 1.2rem;
            transition: transform .3s;
        }
        .feature-card:hover .feature-icon-wrap { transform: scale(1.1) rotate(-3deg); }

        .feature-card h5 { font-weight: 700; font-size: 1.02rem; margin-bottom: .5rem; color: var(--text-dark); }
        .feature-desc { font-size: .875rem; color: var(--text-muted); line-height: 1.65; margin-bottom: .8rem; }
        .feature-detail { font-size: .82rem; color: #475569; background: #f8fafc; border-radius: 8px; padding: 10px 12px; border-left: 3px solid var(--brand-light); }

        /* ── Pricing ─────────────────────────────────────── */
        .pricing-section {
            padding: 90px 0;
            background: linear-gradient(180deg, #f0f5ff 0%, #e8f4f8 100%);
            position: relative;
            overflow: hidden;
        }
        .pricing-section::before {
            content: '';
            position: absolute;
            top: -200px; right: -200px;
            width: 600px; height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37,99,171,.06) 0%, transparent 70%);
        }

        .plan-card {
            background: white;
            border: 1.5px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 2.2rem 2rem;
            height: 100%;
            display: flex;
            flex-direction: column;
            transition: all .3s;
            position: relative;
        }
        .plan-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-lg); }
        .plan-card.featured {
            border-color: var(--brand);
            background: linear-gradient(160deg, #ffffff 0%, #f0f7ff 100%);
            box-shadow: 0 16px 48px rgba(26,58,92,.18);
        }

        .plan-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
            color: white;
            padding: 5px 20px;
            border-radius: 999px;
            font-size: .78rem;
            font-weight: 700;
            white-space: nowrap;
            box-shadow: 0 4px 14px rgba(26,58,92,.30);
        }

        .plan-name {
            font-size: 1.3rem;
            font-weight: 800;
            text-align: center;
            margin-bottom: .3rem;
        }
        .plan-desc { font-size: .85rem; color: var(--text-muted); text-align: center; min-height: 36px; }

        .plan-price {
            font-size: 2.8rem;
            font-weight: 900;
            line-height: 1;
            letter-spacing: -2px;
        }
        .plan-period { font-size: .88rem; color: var(--text-muted); font-weight: 400; }
        .plan-users {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #f0f7ff;
            color: var(--brand-mid);
            padding: 5px 14px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 600;
            margin-top: .6rem;
        }

        .plan-divider { border: none; border-top: 1px solid var(--border); margin: 1.2rem 0; }

        .plan-feature {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 10px;
            font-size: .88rem;
            color: #334155;
        }
        .plan-check { color: var(--accent); font-size: 1rem; flex-shrink: 0; margin-top: 1px; }

        .btn-plan {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            padding: 13px;
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: .95rem;
            text-decoration: none;
            transition: all .25s;
            border: none;
            margin-top: auto;
        }
        .btn-plan-primary {
            background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
            color: white;
            box-shadow: 0 4px 16px rgba(26,58,92,.30);
        }
        .btn-plan-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(26,58,92,.40); color: white; }
        .btn-plan-outline {
            background: transparent;
            color: var(--brand-light);
            border: 1.5px solid var(--brand-light) !important;
        }
        .btn-plan-outline:hover { background: #f0f7ff; transform: translateY(-2px); color: var(--brand-light); }

        /* ── CTA Banner ──────────────────────────────────── */
        .cta-section {
            padding: 80px 0;
            background: linear-gradient(135deg, var(--brand) 0%, var(--brand-mid) 50%, #0d3060 100%);
            position: relative;
            overflow: hidden;
        }
        .cta-section::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 80% at 80% 50%, rgba(22,163,74,.18) 0%, transparent 55%);
        }
        .cta-section .container { position: relative; z-index: 1; }

        .cta-section h2 {
            font-size: clamp(1.8rem, 3.5vw, 2.5rem);
            font-weight: 900;
            color: white;
            letter-spacing: -.8px;
        }
        .cta-section p { color: rgba(255,255,255,.7); font-size: 1rem; }

        /* ── Footer ──────────────────────────────────────── */
        .footer {
            background: #0a1929;
            color: rgba(255,255,255,.55);
            padding: 60px 0 32px;
        }
        .footer-brand { color: white; font-weight: 800; font-size: 1.15rem; letter-spacing: -.2px; }
        .footer-brand-sub { font-size: .82rem; color: rgba(255,255,255,.4); margin-top: 4px; }
        .footer-heading { color: rgba(255,255,255,.85); font-weight: 700; font-size: .82rem; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 1rem; }
        .footer-link { display: block; color: rgba(255,255,255,.5); font-size: .87rem; text-decoration: none; margin-bottom: 8px; transition: color .2s; }
        .footer-link:hover { color: white; }
        .footer-divider { border-color: rgba(255,255,255,.08); margin: 2rem 0 1.5rem; }
        .footer-copy { font-size: .8rem; color: rgba(255,255,255,.3); transition: color .2s; }
        .footer-copy:hover { color: white; }

        /* ── Utility ─────────────────────────────────────── */
        .gradient-text {
            background: linear-gradient(90deg, var(--brand-light) 0%, var(--accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ── Responsive ──────────────────────────────────── */
        @@media (max-width: 575px) {
            .hero { min-height: 100svh; }
            .hero h1 { font-size: 2rem; letter-spacing: -.8px; }
            .hero-sub { font-size: .95rem; }
            .btn-hero-primary, .btn-hero-ghost { width: 100%; justify-content: center; }
            .stat-divider { display: none; }
        }
        @@media (max-width: 767px) {
            .steps-section, .features-section, .pricing-section, .cta-section { padding: 60px 0; }
        }

        /* --- Chat Support Widget --- */
        .chat-support-btn {
            position: fixed;
            bottom: 24px;
            right: 24px;
            width: 56px;
            height: 56px;
            background: var(--brand);
            color: white;
            border: none;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            cursor: pointer;
            box-shadow: 0 4px 20px rgba(26,58,92,0.35);
            transition: all 0.2s;
            z-index: 1000;
        }
        .chat-support-btn:hover { transform: scale(1.1); background: #112a44; }

        .chat-panel {
            position: fixed;
            bottom: 90px;
            right: 24px;
            width: 340px;
            background: white;
            border-radius: var(--radius-lg);
            box-shadow: 0 10px 40px rgba(0,0,0,0.15);
            z-index: 1001;
            display: none;
            overflow: hidden;
        }
        .chat-panel.open { display: block; }

        .chat-header {
            background: var(--brand);
            color: white;
            padding: 1rem 1.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .chat-header-title { font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: 8px; }
        .chat-close { background: none; border: none; color: white; font-size: 1.25rem; cursor: pointer; opacity: 0.8; }
        .chat-close:hover { opacity: 1; }

        .chat-body { padding: 1.25rem; max-height: 300px; overflow-y: auto; }
        .chat-message { background: #f1f5f9; padding: 12px 16px; border-radius: 12px; margin-bottom: 12px; font-size: 0.9rem; line-height: 1.5; }
        .chat-message.support { background: #e0f2fe; }

        .chat-input-area { padding: 1rem; border-top: 1px solid var(--border); display: flex; gap: 8px; }
        .chat-input { flex: 1; border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; font-size: 0.9rem; }
        .chat-input:focus { outline: none; border-color: var(--brand-light); }
        .chat-send { background: var(--brand); color: white; border: none; padding: 10px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; }
        .chat-send:hover { background: #112a44; }
    </style>
</head>

<body>

    <!-- ═══════════════ HERO ═══════════════ -->
    <section class="hero" id="hero-section">
        <div class="hero-grain"></div>
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-orb hero-orb-3"></div>

        <div class="container text-center hero-content py-5">
            <!-- Logo -->
            <div class="d-flex justify-content-center mb-4">
                <img src="~/images/jasmine-logo.png" class="hero-logo-img" alt="JAS-MINE Logo" />
            </div>

            <div class="d-flex justify-content-center">
                <div class="hero-badge">
                    <span class="dot"></span>
                    Now available for all barangays
                </div>
            </div>

            <h1>
                JAS-MINE ERP System for Barangays
            </h1>

            <p class="hero-sub mx-auto">
                Centralized ERP-based Knowledge Management System designed to help barangays manage documents, policies, and operational knowledge efficiently and securely.
            </p>

            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                <a asp-controller="Home" asp-action="Login" class="btn-hero-ghost">
                    Login
                </a>
                <a asp-action="Register" class="btn-hero-primary">
                    Get Started <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <div class="scroll-cue">
            <span>Scroll</span>
            <i class="bi bi-chevron-double-down"></i>
        </div>
    </section>

    <!-- ═══════════════ HOW IT WORKS ═══════════════ -->
    <section class="steps-section" id="how-it-works">
        <div class="container">
            <div class="text-center mb-5">
                <div class="step-pill"><i class="bi bi-lightning-charge-fill"></i> Simple & Fast</div>
                <h2 class="section-title">Up and running in minutes</h2>
                <p class="section-sub mx-auto">Three easy steps to digitize your barangay's knowledge management.</p>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-12 col-md-4">
                    <div class="step-card">
                        <div class="step-number">1</div>
                        <h5>Choose a Plan</h5>
                        <p>Select the subscription plan that matches your barangay's size and operational needs. No setup fees, no hidden charges.</p>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="step-card">
                        <div class="step-number">2</div>
                        <h5>Set Up Your Workspace</h5>
                        <p>Create your barangay profile, invite staff, define roles, and configure access permissions in a few clicks.</p>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="step-card">
                        <div class="step-number">3</div>
                        <h5>Start Managing Knowledge</h5>
                        <p>Upload documents, draft policies, share insights, and track every action—all from one centralized dashboard.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════ FEATURES ═══════════════ -->
    <section class="features-section" id="features-section">
        <div class="container">
            <div class="text-center mb-5">
                <div class="section-eyebrow">Smart Solutions</div>
                <h2 class="section-title">Featured Modules</h2>
                <p class="section-sub mx-auto">Core modules powering barangay knowledge management</p>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-12 col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-wrap" style="background:#f0f5ff;color:var(--brand-light);">
                            <i class="bi bi-book"></i>
                        </div>
                        <h5>Knowledge Repository Module</h5>
                        <p class="feature-desc">Store, organize, and access official barangay documents in a centralized and secure repository.</p>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-wrap" style="background:#f0f7ff;color:var(--brand-light);">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <h5>Policy and Procedures Management Module</h5>
                        <p class="feature-desc">Create, update, and manage barangay policies and procedures with approval tracking.</p>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-wrap" style="background:#fffcf0;color:var(--gold);">
                            <i class="bi bi-lightbulb"></i>
                        </div>
                        <h5>Lessons Learned Management Module</h5>
                        <p class="feature-desc">Record and review lessons learned from past barangay activities to improve future decisions.</p>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-wrap" style="background:#f0faf0;color:var(--accent);">
                            <i class="bi bi-award"></i>
                        </div>
                        <h5>Best Practices Database Module</h5>
                        <p class="feature-desc">Maintain a collection of proven best practices to guide barangay staff operations.</p>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="feature-card">
                        <div class="feature-icon-wrap" style="background:#f5faff;color:#0284c7;">
                            <i class="bi bi-share"></i>
                        </div>
                        <h5>Knowledge Sharing Portal Module</h5>
                        <p class="feature-desc">Allow barangay staff to share discussions, announcements, and knowledge collaboratively.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════════════ PRICING ═══════════════ -->
    <section class="pricing-section" id="plans-section">
        <div class="container py-2">
            <div class="text-center mb-5">
                <div class="section-eyebrow">Pricing Plans</div>
                <h2 class="section-title">Subscription Plans</h2>
                <p class="section-sub mx-auto">Choose a plan that fits your barangay's needs</p>
            </div>

            @if (!plans.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size:3rem;color:#cbd5e1;"></i>
                    <p class="text-muted mt-3">No subscription plans available at the moment. Please check back later.</p>
                </div>
            }
            else
            {
                <div class="row g-4 justify-content-center">
                    @for (int i = 0; i < planCount; i++)
                    {
                        var plan         = plans[i];
                        var isRecommended = plan.Name == "Professional";
                        var features     = (plan.Features ?? "").Split(new[] { ';', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                        var priceColor   = isRecommended ? "var(--brand)" : "#0284c7";

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="plan-card @(isRecommended ? "featured" : "")">

                                @if (isRecommended)
                                {
                                    <div class="plan-badge">
                                        <i class="bi bi-star-fill me-1"></i> Recommended
                                    </div>
                                }

                                <div class="@(isRecommended ? "mt-3" : "")">
                                    <div class="plan-name" style="color:@priceColor;">@plan.Name</div>
                                    
                                    <div class="text-center">
                                        <span class="plan-users">
                                            <i class="bi bi-people-fill"></i>
                                            Up to @plan.UserLimit users
                                        </span>
                                    </div>

                                    <div class="text-center my-3">
                                        <div class="d-flex align-items-center justify-content-center">
                                            <span class="plan-price" style="color:@priceColor;">₱@string.Format("{0:N0}", plan.Price)</span>
                                            <span class="plan-period">/ month</span>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                                    {
                                        <p class="plan-desc">@plan.Description</p>
                                    }
                                </div>

                                <hr class="plan-divider" />

                                <div class="mb-4 flex-grow-1">
                                    @foreach (var feature in features)
                                    {
                                        <div class="plan-feature">
                                            <i class="bi bi-check-circle-fill plan-check"></i>
                                            <span>@feature.Trim()</span>
                                        </div>
                                    }
                                </div>

                                @{
                                    var subscribeUrl = User.Identity?.IsAuthenticated == true
                                        ? Url.Action("SelectPlan", "Home") + "?planId=" + plan.Id
                                        : Url.Action("Login", "Home") + "?planId=" + plan.Id;
                                }
                                <a asp-controller="Home" asp-action="Register"
                                   class="btn-plan @(isRecommended ? "btn-plan-primary" : "btn-plan-outline")">
                                    Get Started
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ═══════════════ FOOTER ═══════════════ -->
    <footer class="footer">
        <div class="container">
            <div class="row g-4 mb-3">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="footer-brand">JAS-MINE ERP</span>
                    </div>
                    <div class="footer-brand-sub">Barangay Knowledge Management System</div>
                    <p class="mt-3" style="font-size:.83rem;line-height:1.7;">
                        An integrated ERP-based platform designed to help Philippine barangays operate more efficiently, transparently, and securely.
                    </p>
                </div>

                <div class="col-6 col-md-2 offset-md-2">
                    <div class="footer-heading">Platform</div>
                    <a href="#features-section" class="footer-link">Modules</a>
                    <a href="#how-it-works" class="footer-link">How It Works</a>
                    <a href="#plans-section" class="footer-link">Pricing</a>
                </div>

                <div class="col-6 col-md-2">
                    <div class="footer-heading">Account</div>
                    <a asp-controller="Home" asp-action="Login" class="footer-link">Login</a>
                    <a href="#plans-section" class="footer-link">Subscribe</a>
                    <a asp-controller="Home" asp-action="ForgotPassword" class="footer-link">Forgot Password</a>
                </div>

                <div class="col-12 col-md-2">
                    <div class="footer-heading">Contact</div>
                    <a href="javascript:void(0)" onclick="toggleChat()" class="footer-link">support@jasmine.gov.ph</a>
                    <span class="footer-link" style="cursor:default;">Philippines</span>
                </div>
            </div>

            <hr class="footer-divider" />

            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
                <div class="footer-copy">© @year JAS-MINE. An Integrated ERP-Based Knowledge Management System for Barangays. All rights reserved.</div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="PrivacyPolicy" class="footer-copy text-decoration-none">Privacy Policy</a>
                    <a asp-controller="Home" asp-action="TermsOfUse" class="footer-copy text-decoration-none">Terms of Use</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Chat Support Widget -->
    <button class="chat-support-btn" onclick="toggleChat()" title="Chat Support">
        <i class="bi bi-chat-dots-fill"></i>
    </button>

    <div class="chat-panel" id="chatPanel">
        <div class="chat-header">
            <div class="chat-header-title">
                <i class="bi bi-headset"></i> Support Chat
            </div>
            <button class="chat-close" onclick="toggleChat()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="chat-body" id="chatBody">
            <div class="chat-message support">
                <strong>JAS-MINE Support</strong><br>
                Hi! 👋 How can we help you today? For any questions about our services, we're here to assist.
            </div>
        </div>
        <div class="chat-input-area">
            <input type="text" class="chat-input" id="chatInput" placeholder="Type your message..." onkeypress="handleChatKeypress(event)" />
            <button class="chat-send" onclick="sendMessage()">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>

    <script>
        function toggleChat() {
            const panel = document.getElementById('chatPanel');
            panel.classList.toggle('open');
            if (panel.classList.contains('open')) {
                document.getElementById('chatInput').focus();
            }
        }

        function handleChatKeypress(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        }

        function sendMessage() {
            const input = document.getElementById('chatInput');
            const message = input.value.trim();
            if (!message) return;

            const chatBody = document.getElementById('chatBody');
            
            // Add user message
            const userMsg = document.createElement('div');
            userMsg.className = 'chat-message';
            userMsg.innerHTML = '<strong>You</strong><br>' + escapeHtml(message);
            chatBody.appendChild(userMsg);
            
            input.value = '';
            chatBody.scrollTop = chatBody.scrollHeight;

            // Auto-reply after short delay
            setTimeout(() => {
                const supportMsg = document.createElement('div');
                supportMsg.className = 'chat-message support';
                supportMsg.innerHTML = '<strong>JAS-MINE Support</strong><br>Thank you for your message! Our support team will get back to you shortly.';
                chatBody.appendChild(supportMsg);
                chatBody.scrollTop = chatBody.scrollHeight;
            }, 1000);
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>
