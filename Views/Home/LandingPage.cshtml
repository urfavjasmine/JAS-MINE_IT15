@using JAS_MINE_IT15.Models.Entities
@{
    ViewData["Title"] = "JAS-MINE Landing";
    Layout = null;
    var year = DateTime.Now.Year;
    var plans = (ViewBag.Plans as List<SubscriptionPlan>) ?? new List<SubscriptionPlan>();
    var planCount = plans.Count;
    var midIndex = planCount > 2 ? 1 : -1; // second plan is "Most Popular"

    // colours per tier for visual distinction
    string[] tierColors  = { "#0d6efd", "#1f3f63", "#198754" };
    string[] tierBgs     = { "rgba(13,110,253,.08)", "rgba(31,63,99,.08)", "rgba(25,135,84,.08)" };
    string[] tierBtnClass = { "btn-outline-primary", "btn-primary", "btn-success" };
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root { --brand: #1f3f63; --brand-light: #2a5a8a; --accent: #2e8b3c; }

        html { scroll-behavior: smooth; }

        .hero {
            min-height: 78vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at 70% 15%, rgba(47,222,173,.10) 0%, rgba(0,0,0,0) 55%),
                        linear-gradient(180deg, #0b2f4d 0%, #0a3557 35%, #1b4d72 100%);
            color: #fff;
        }
        .hero h1 { letter-spacing: .2px; }
        .hero p  { max-width: 840px; }

        .btn-hero { min-width: 120px; border-radius: 10px; padding: 12px 18px; font-weight: 400; }
        .btn-subscribe { background: var(--accent); border-color: var(--accent); }
        .btn-subscribe:hover { background: #267433; border-color: #267433; }

        .section-pad { padding: 72px 0; }

        .icon-badge {
            height: 60px; width: 60px; border-radius: 12px;
            display: inline-flex; align-items: center; justify-content: center;
            background: rgba(13,110,253,.12); color: #0d6efd; font-size: 20px;
        }

        /* ── Role access badges on module cards ── */
        .role-badge {
            display: inline-block; font-size: .72rem; font-weight: 600;
            padding: 3px 9px; border-radius: 999px; margin: 2px 2px 2px 0;
        }
        .role-admin     { background: #dbeafe; color: #1e40af; }
        .role-secretary  { background: #fef3c7; color: #92400e; }
        .role-staff      { background: #d1fae5; color: #065f46; }
        .role-council    { background: #ede9fe; color: #5b21b6; }
        .role-section-label { font-size: .8rem; color: #6b7280; font-weight: 600; margin-top: 12px; margin-bottom: 4px; }
        .module-what { font-size: .85rem; color: #6c757d; margin-top: 8px; line-height: 1.5; }

        /* ── Plan Cards ── */
        .plan-card {
            border-radius: 16px; cursor: pointer;
            transition: transform .2s, box-shadow .2s, border-color .2s;
            border: 2px solid transparent;
        }
        .plan-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px rgba(0,0,0,.10); }
        .plan-card.featured { border-color: var(--brand); }

        .plan-price { font-size: 2.3rem; font-weight: 800; color: var(--brand); }
        .plan-duration { color: #6c757d; font-size: .95rem; }

        .feature-item { display: flex; align-items: start; gap: 8px; margin-bottom: 10px; font-size: .93rem; }
        .feature-icon { color: var(--accent); font-size: 1.1rem; margin-top: 2px; flex-shrink: 0; }

        .plan-btn { border-radius: 10px; padding: 10px 14px; width: 100%; font-weight: 500; transition: all .2s; text-decoration: none; }
        .plan-btn:hover { opacity: .88; transform: scale(1.02); }

        /* Modules explanation text */
        .module-explain { font-size: .82rem; color: #6c757d; margin-top: 2px; }
    </style>
</head>

<body class="bg-light">

    <!-- ═══════ Navbar ═══════ -->
    <header style="background:#f3f4f6; border-bottom:1px solid #e5e7eb;">
        <div class="container d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center gap-2">
                <img src="~/images/jasmine-logo.png" style="height:60px;width:60px;object-fit:contain;" />
                <span style="font-weight:700;font-size:20px;color:var(--brand);">JAS-MINE</span>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Home" asp-action="Login"
                   class="btn" style="border:1px solid #d1d5db;background:#fff;color:#374151;padding:6px 16px;border-radius:8px;">Login</a>
                <a href="#plans-section"
                   class="btn" style="background:var(--brand);color:white;padding:6px 16px;border-radius:8px;">Subscribe</a>
            </div>
        </div>
    </header>

    <!-- ═══════ Hero ═══════ -->
    <section class="hero">
        <div class="container text-center py-5">
            <h1 class="fw-bold display-5">JAS-MINE ERP System for Barangays</h1>
            <p class="mx-auto mt-3 text-white-50 fs-6">
                Centralized ERP-based Knowledge Management System designed to help barangays manage documents,
                policies, and operational knowledge efficiently and securely.
            </p>
            <div class="mt-4 d-flex flex-column flex-sm-row gap-3 justify-content-center">
                <a class="btn btn-light btn-hero" asp-controller="Home" asp-action="Login">Login</a>
                <a class="btn btn-subscribe text-white btn-hero" href="#plans-section">
                    Subscribe Now <span class="ms-2">&rarr;</span>
                </a>
            </div>
        </div>
    </section>

    <!-- ═══════ Features (Modules Explained) ═══════ -->
    <section class="section-pad bg-white" id="features-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold">Featured Modules</h2>
                <p class="text-muted mb-0">Core modules powering barangay knowledge management</p>
            </div>

            <div class="row g-4">
                <!-- Module 1: Knowledge Repository -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="icon-badge mb-3">📚</div>
                            <h5 class="fw-semibold">Knowledge Repository</h5>
                            <p class="text-muted mb-2">Store, organize, and access official barangay documents in a centralized and secure repository.</p>
                            <div class="module-what">
                                <strong>What it does:</strong> Upload barangay resolutions, ordinances, and official files.
                                Search and retrieve documents anytime. Control who can view or edit each file.
                            </div>
                            <div class="role-section-label"><i class="bi bi-people-fill me-1"></i>Role Access</div>
                            <div>
                                <span class="role-badge role-admin">Admin &mdash; Full access</span>
                                <span class="role-badge role-secretary">Secretary &mdash; Upload &amp; edit</span>
                                <span class="role-badge role-staff">Staff &mdash; View &amp; download</span>
                                <span class="role-badge role-council">Council &mdash; View only</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Module 2: Policy & Procedures -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="icon-badge mb-3">📄</div>
                            <h5 class="fw-semibold">Policy &amp; Procedures Management</h5>
                            <p class="text-muted mb-2">Create, update, and manage barangay policies and procedures with approval tracking.</p>
                            <div class="module-what">
                                <strong>What it does:</strong> Draft new policies and send them for approval.
                                Track which policies are pending, approved, or rejected. Keep an organized history of all barangay rules.
                            </div>
                            <div class="role-section-label"><i class="bi bi-people-fill me-1"></i>Role Access</div>
                            <div>
                                <span class="role-badge role-admin">Admin &mdash; Full access &amp; approve</span>
                                <span class="role-badge role-secretary">Secretary &mdash; Draft &amp; edit</span>
                                <span class="role-badge role-staff">Staff &mdash; View policies</span>
                                <span class="role-badge role-council">Council &mdash; Review &amp; comment</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Module 3: Lessons Learned -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="icon-badge mb-3">💡</div>
                            <h5 class="fw-semibold">Lessons Learned</h5>
                            <p class="text-muted mb-2">Record and review lessons learned from past barangay activities to improve future decisions.</p>
                            <div class="module-what">
                                <strong>What it does:</strong> Document what worked and what didn't in past projects.
                                Share insights so the whole team learns from every experience and avoids repeating mistakes.
                            </div>
                            <div class="role-section-label"><i class="bi bi-people-fill me-1"></i>Role Access</div>
                            <div>
                                <span class="role-badge role-admin">Admin &mdash; Full access</span>
                                <span class="role-badge role-secretary">Secretary &mdash; Create &amp; edit</span>
                                <span class="role-badge role-staff">Staff &mdash; Create &amp; view</span>
                                <span class="role-badge role-council">Council &mdash; View &amp; comment</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Module 4: Best Practices -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="icon-badge mb-3">🏆</div>
                            <h5 class="fw-semibold">Best Practices Database</h5>
                            <p class="text-muted mb-2">Maintain a collection of proven best practices to guide barangay staff operations.</p>
                            <div class="module-what">
                                <strong>What it does:</strong> Save step-by-step guides and proven methods for common tasks.
                                New staff can quickly learn the right way to do things using your barangay's own playbook.
                            </div>
                            <div class="role-section-label"><i class="bi bi-people-fill me-1"></i>Role Access</div>
                            <div>
                                <span class="role-badge role-admin">Admin &mdash; Full access</span>
                                <span class="role-badge role-secretary">Secretary &mdash; Create &amp; edit</span>
                                <span class="role-badge role-staff">Staff &mdash; View &amp; follow</span>
                                <span class="role-badge role-council">Council &mdash; View only</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Module 5: Knowledge Sharing -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="icon-badge mb-3">🔗</div>
                            <h5 class="fw-semibold">Knowledge Sharing Portal</h5>
                            <p class="text-muted mb-2">Allow barangay staff to share discussions, announcements, and knowledge collaboratively.</p>
                            <div class="module-what">
                                <strong>What it does:</strong> Post announcements, start discussion threads, and share updates.
                                Like a private social forum for your barangay team to communicate and collaborate.
                            </div>
                            <div class="role-section-label"><i class="bi bi-people-fill me-1"></i>Role Access</div>
                            <div>
                                <span class="role-badge role-admin">Admin &mdash; Full access</span>
                                <span class="role-badge role-secretary">Secretary &mdash; Post &amp; moderate</span>
                                <span class="role-badge role-staff">Staff &mdash; Post &amp; reply</span>
                                <span class="role-badge role-council">Council &mdash; Post &amp; reply</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Module 6: Audit Logs -->
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="icon-badge mb-3" style="background:rgba(220,53,69,.12);color:#dc3545;">🔒</div>
                            <h5 class="fw-semibold">Audit Logs &amp; Security</h5>
                            <p class="text-muted mb-2">Track every action in the system with detailed audit trails for accountability.</p>
                            <div class="module-what">
                                <strong>What it does:</strong> Automatically records who did what and when.
                                Ensures full transparency and helps resolve disputes with an unalterable activity log.
                            </div>
                            <div class="role-section-label"><i class="bi bi-people-fill me-1"></i>Role Access</div>
                            <div>
                                <span class="role-badge role-admin">Admin &mdash; View all logs</span>
                                <span class="role-badge role-secretary">Secretary &mdash; View own logs</span>
                                <span class="role-badge role-staff">Staff &mdash; View own logs</span>
                                <span class="role-badge role-council">Council &mdash; View own logs</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══════ Subscription Plans (Dynamic from DB) ═══════ -->
    <section class="py-5" style="background:#f5f6f8;" id="plans-section">
        <div class="container py-4">

            <div class="text-center mb-5">
                <h2 class="fw-bold" style="font-size:36px;">Subscription Plans</h2>
                <p class="text-muted" style="font-size:16px;">Choose a plan that fits your barangay's needs</p>
            </div>

            @if (!plans.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox" style="font-size:3rem;color:#ced4da;"></i>
                    <p class="text-muted mt-2">No subscription plans available at the moment. Please check back later.</p>
                </div>
            }
            else
            {
                <div class="row g-4 justify-content-center align-items-stretch">
                    @for (int i = 0; i < planCount; i++)
                    {
                        var plan = plans[i];
                        var isFeatured = (i == midIndex);
                        var features = (plan.Features ?? "").Split(new[] { ';', '\n' }, StringSplitOptions.RemoveEmptyEntries);
                        var durationLabel = plan.DurationMonths >= 12
                            ? (plan.DurationMonths / 12 == 1 ? "1 Year" : $"{plan.DurationMonths / 12} Years")
                            : (plan.DurationMonths == 1 ? "1 Month" : $"{plan.DurationMonths} Months");
                        var colorIdx = Math.Min(i, tierColors.Length - 1);

                        <div class="col-12 col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm plan-card @(isFeatured ? "featured" : "border-0")"
                                 data-plan-id="@plan.Id" data-plan-name="@plan.Name" data-plan-price="@plan.Price">
                                <div class="card-body p-4 p-lg-5 d-flex flex-column position-relative">

                                    @* Most Popular pill *@
                                    @if (isFeatured)
                                    {
                                        <div class="position-absolute top-0 start-50 translate-middle">
                                            <span class="badge text-white"
                                                  style="background:var(--brand);padding:7px 16px;border-radius:999px;font-weight:600;">
                                                <i class="bi bi-star-fill me-1"></i> Most Popular
                                            </span>
                                        </div>
                                    }

                                    <!-- Plan Name -->
                                    <h4 class="fw-bold text-center mb-1 @(isFeatured ? "mt-2" : "")"
                                        style="color:@tierColors[colorIdx];">@plan.Name</h4>

                                    @if (!string.IsNullOrWhiteSpace(plan.Description))
                                    {
                                        <p class="text-muted text-center small mb-3">@plan.Description</p>
                                    }

                                    <!-- Price -->
                                    <div class="text-center mb-2">
                                        <span class="plan-price" style="color:@tierColors[colorIdx];">₱@string.Format("{0:N0}", plan.Price)</span>
                                        <span class="plan-duration">/ @durationLabel</span>
                                    </div>

                                    <!-- Duration badge -->
                                    <div class="text-center mb-3">
                                        <span class="badge bg-light text-secondary border" style="font-size:.82rem;">
                                            <i class="bi bi-calendar3 me-1"></i> @durationLabel subscription
                                        </span>
                                    </div>

                                    <!-- Features grouped by role label -->
                                    <hr class="my-2" />
                                    <div class="mb-4 flex-grow-1">
                                        @foreach (var feature in features)
                                        {
                                            var trimmed = feature.Trim();
                                            var isRoleRow = trimmed.StartsWith("👥");
                                            <div class="feature-item @(isRoleRow ? "mt-1 mb-2" : "")">
                                                @if (isRoleRow)
                                                {
                                                    <span class="fw-semibold" style="font-size:.92rem;color:@tierColors[colorIdx];">@trimmed</span>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check-circle-fill feature-icon"></i>
                                                    <span>@trimmed</span>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Subscribe Now button (direct redirect) -->
                                    <a href="@Url.Action("Login", "Home")?planId=@plan.Id"
                                       class="plan-btn btn @tierBtnClass[colorIdx] mt-auto text-center"
                                       style="border-radius:10px;padding:12px 14px;font-weight:600;">
                                        <i class="bi bi-arrow-right-circle me-1"></i> Subscribe Now
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- ═══════ Footer ═══════ -->
    <footer class="border-top bg-white py-4" style="margin-bottom:0;">
        <div class="container text-center">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                <img src="~/images/jasmine-logo.png" alt="JAS-MINE" style="height:24px;width:24px;object-fit:contain;" />
                <span class="fw-semibold" style="color:var(--brand);">JAS-MINE ERP System</span>
            </div>
            <div class="text-muted small mb-1">Barangay Knowledge Management ERP</div>
            <div class="text-muted">© @year JAS-MINE: An Integrated ERP-Based Knowledge Management System for Barangays. All rights reserved.</div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
