@{
    ViewData["Title"] = "Terms of Use - JAS-MINE";
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f1f5fb;
            color: #0f172a;
            min-height: 100vh;
        }
        .policy-nav {
            background: linear-gradient(135deg, #14513d 0%, #1a7a5a 100%);
            padding: 16px 32px;
            display: flex;
            align-items: center;
            gap: 14px;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 2px 12px rgba(26,122,90,0.2);
        }
        .policy-nav .brand { color: white; font-weight: 800; font-size: 18px; letter-spacing: -0.5px; }
        .policy-nav .badge-pill {
            background: rgba(255,255,255,0.18);
            color: white;
            padding: 4px 12px;
            border-radius: 99px;
            font-size: 12px;
            font-weight: 600;
        }
        .policy-nav .back-btn {
            margin-left: auto;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.25);
            color: white;
            padding: 7px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: background 0.2s;
        }
        .policy-nav .back-btn:hover { background: rgba(255,255,255,0.28); color: white; }

        .policy-hero {
            background: linear-gradient(135deg, #14513d 0%, #1a7a5a 100%);
            color: white;
            padding: 56px 32px 80px;
            text-align: center;
        }
        .policy-hero .icon-wrap {
            width: 72px; height: 72px;
            background: rgba(255,255,255,0.15);
            border-radius: 20px;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 32px;
            margin-bottom: 20px;
        }
        .policy-hero h1 { font-size: 36px; font-weight: 800; margin-bottom: 10px; }
        .policy-hero p { opacity: 0.8; font-size: 15px; }

        .policy-card {
            max-width: 860px;
            margin: -40px auto 60px;
            background: white;
            border-radius: 20px;
            box-shadow: 0 12px 48px rgba(26,122,90,0.10);
            overflow: hidden;
        }
        .policy-card-body { padding: 44px 52px; }
        .section-block {
            display: flex;
            gap: 20px;
            padding: 24px 0;
            border-bottom: 1px solid #f0f4fa;
        }
        .section-block:last-child { border-bottom: none; }
        .section-num {
            width: 38px; height: 38px;
            background: linear-gradient(135deg, #14513d, #1a7a5a);
            color: white;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-weight: 800;
            font-size: 15px;
            flex-shrink: 0;
            margin-top: 3px;
        }
        .section-block h5 { font-size: 16px; font-weight: 700; margin-bottom: 8px; color: #0f1e3c; }
        .section-block p { font-size: 14px; color: #475569; line-height: 1.75; margin: 0; }
        .policy-footer {
            background: #f4faf7;
            border-top: 1px solid #d4ece1;
            padding: 24px 52px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }
        .policy-footer small { color: #94a3b8; font-size: 13px; }
        @@media (max-width: 600px) {
            .policy-card-body { padding: 28px 20px; }
            .policy-footer { padding: 20px; }
            .policy-hero { padding: 40px 20px 70px; }
            .policy-hero h1 { font-size: 26px; }
        }
    </style>
</head>
<body>
    <!-- Top Navigation -->
    <nav class="policy-nav">
        <div>
            <img src="~/images/jaslogo.png" alt="JAS-MINE" style="height:32px;" onerror="this.style.display='none'" />
        </div>
        <div class="brand">JAS-MINE</div>
        <span class="badge-pill">ERP System</span>
        <a href="@Url.Action("LandingPage", "Home")" class="back-btn">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </nav>

    <!-- Hero -->
    <div class="policy-hero">
        <div class="icon-wrap"><i class="bi bi-file-earmark-check"></i></div>
        <h1>Terms of Use</h1>
        <p>Last updated: @DateTime.Now.ToString("MMMM dd, yyyy") &nbsp;&bull;&nbsp; Please read carefully before using the system</p>
    </div>

    <!-- Content -->
    <div class="container px-3">
        <div class="policy-card">
            <div class="policy-card-body">

                <div class="section-block">
                    <div class="section-num">1</div>
                    <div>
                        <h5>Acceptance of Terms</h5>
                        <p>By accessing or using the JAS-MINE ERP Knowledge Management System, you agree to be bound by these Terms of Use. If you do not agree to these terms, you must not access or use the system. Continued use of the platform constitutes your acceptance of any updates to these terms.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">2</div>
                    <div>
                        <h5>Authorized Use</h5>
                        <p>Access to JAS-MINE is granted only to authorized barangay personnel who are registered by their respective Barangay Administrator. Users must use the system solely for legitimate barangay operations, knowledge management, and administrative purposes as intended by the platform.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">3</div>
                    <div>
                        <h5>User Responsibilities</h5>
                        <p>Each user is responsible for maintaining the confidentiality of their login credentials and for all activities performed under their account. Users must keep their information accurate, timely, and complete. Sharing accounts or credentials with unauthorized individuals is strictly prohibited.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">4</div>
                    <div>
                        <h5>Prohibited Activities</h5>
                        <p>Users are prohibited from: attempting to gain unauthorized access to the system; uploading malicious files, viruses, or harmful content; misusing or misrepresenting barangay information; or engaging in any activity that disrupts the service or violates any applicable law or regulation.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">5</div>
                    <div>
                        <h5>Subscription & Payments</h5>
                        <p>JAS-MINE services are provided on a subscription basis. Subscriptions are tied to individual barangays and must be maintained to retain access to the system. Payment obligations must be fulfilled in accordance with the selected plan. The system administrators reserve the right to suspend access for overdue or unpaid accounts.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">6</div>
                    <div>
                        <h5>Intellectual Property</h5>
                        <p>All intellectual property within the JAS-MINE system, including but not limited to its design, software, and proprietary features, is the property of the JAS-MINE development team. Barangay-generated content (documents, policies, etc.) remains the property of the respective barangay.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">7</div>
                    <div>
                        <h5>Limitation of Liability</h5>
                        <p>JAS-MINE and its developers shall not be liable for any indirect, incidental, or consequential damages arising from the use or inability to use the system, data loss, or service interruptions. The platform is provided "as is" and we make no warranties of uninterrupted or error-free operation.</p>
                    </div>
                </div>

                <div class="section-block">
                    <div class="section-num">8</div>
                    <div>
                        <h5>Changes to Terms</h5>
                        <p>We reserve the right to modify these Terms of Use at any time. Changes will be communicated through the system or via email. Your continued use of the platform after any changes constitutes your acceptance of the revised terms.</p>
                    </div>
                </div>

            </div>
            <div class="policy-footer">
                <small>&copy; @DateTime.Now.Year JAS-MINE ERP System. All rights reserved.</small>
                <a href="@Url.Action("PrivacyPolicy", "Home")" style="font-size:13px; color:#1a7a5a;">View Privacy Policy &rarr;</a>
            </div>
        </div>
    </div>
</body>
</html>
