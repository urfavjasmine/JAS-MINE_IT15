@{
    ViewData["Title"] = "Terms of Use - JAS-MINE";
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f8fafc;
            color: #0f172a;
        }
        .policy-container {
            max-width: 800px;
            margin: 40px auto;
            background: #fff;
            padding: 40px 50px;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.05);
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="policy-container">
            <h1 class="fw-bold mb-4">Terms of Use</h1>
            <p class="text-muted mb-4">Last Updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>

            <div class="content lh-lg">
                <h5 class="fw-bold mt-4">1. Acceptance of Terms</h5>
                <p>By accessing and using the JAS-MINE ERP System, you agree to comply with and be bound by these Terms of Use. If you do not agree, please do not use the system.</p>

                <h5 class="fw-bold mt-4">2. Use of Service</h5>
                <p>JAS-MINE provides a centralized platform for barangays to manage documents, policies, and knowledge. You agree to use the service only for lawful and authorized governmental purposes.</p>

                <h5 class="fw-bold mt-4">3. User Accounts</h5>
                <p>You are responsible for maintaining the confidentiality of your account credentials and for all activities that occur under your account. Notify us immediately of any unauthorized use.</p>

                <h5 class="fw-bold mt-4">4. Content Ownership</h5>
                <p>All barangay data, documents, and policies uploaded to JAS-MINE remain the property of the respective barangay. The platform retains rights over the system infrastructure and codebase.</p>

                <h5 class="fw-bold mt-4">5. Limitation of Liability</h5>
                <p>JAS-MINE shall not be liable for any indirect, incidental, special, or consequential damages resulting from the use or inability to use the service.</p>
            </div>
            
            <div class="mt-5 pt-4 border-top">
                <a href="@Url.Action("LandingPage", "Home")" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i> Back to Home
                </a>
            </div>
        </div>
    </div>
</body>
</html>
