@*
    Shared breadcrumb partial.
    Usage: Set ViewData["Breadcrumbs"] to a List of (string Text, string? Url) tuples.
    Example:
        ViewData["Breadcrumbs"] = new List<(string, string?)> {
            ("Dashboard", Url.Action("DashboardHome", "Home")),
            ("Knowledge Repository", null)
        };
*@
@{
    var crumbs = ViewData["Breadcrumbs"] as List<(string Text, string? Url)>;
}

@if (crumbs != null && crumbs.Count > 0)
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0">
            @for (int i = 0; i < crumbs.Count; i++)
            {
                var isLast = i == crumbs.Count - 1;
                if (isLast || string.IsNullOrEmpty(crumbs[i].Url))
                {
                    <li class="breadcrumb-item active" aria-current="page">@crumbs[i].Text</li>
                }
                else
                {
                    <li class="breadcrumb-item"><a href="@crumbs[i].Url">@crumbs[i].Text</a></li>
                }
            }
        </ol>
    </nav>
}
