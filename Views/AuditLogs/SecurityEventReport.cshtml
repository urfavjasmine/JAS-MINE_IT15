@using JAS_MINE_IT15.Controllers
@model SecurityEventReportModel

@{
    ViewData["Title"] = Model.EventType;
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h1 class="mb-0">
                <i class="fas fa-file-alt"></i> @Model.EventType Report
            </h1>
            <p class="text-muted">@Model.StartDate.ToString("MMM d, yyyy") - @Model.EndDate.ToString("MMM d, yyyy")</p>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-sm btn-secondary" onclick="window.print()">
                <i class="fas fa-print"></i> Print
            </button>
            <a href="@Url.Action("Index")" class="btn btn-sm btn-secondary">
                <i class="fas fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-body">
                    <h6 class="card-title text-muted">Total Events</h6>
                    <h3 class="mb-0">@Model.TotalCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-body">
                    <h6 class="card-title text-muted">
                        <i class="fas fa-exclamation-circle text-danger"></i> Critical
                    </h6>
                    <h3 class="mb-0 text-danger">@Model.CriticalCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-body">
                    <h6 class="card-title text-muted">
                        <i class="fas fa-exclamation-triangle text-warning"></i> Warning
                    </h6>
                    <h3 class="mb-0 text-warning">@Model.WarningCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-light">
                <div class="card-body">
                    <h6 class="card-title text-muted">Generated</h6>
                    <small>@Model.GeneratedAt.ToString("HH:mm:ss")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Events Table -->
    <div class="card">
        <div class="card-header bg-light">
            <h6 class="mb-0">
                <i class="fas fa-list"></i> Event Details
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 8%">ID</th>
                        <th style="width: 12%">Timestamp</th>
                        <th style="width: 15%">User</th>
                        <th style="width: 10%">Action</th>
                        <th style="width: 20%">Description</th>
                        <th style="width: 10%">IP Address</th>
                        <th style="width: 10%">Severity</th>
                        <th style="width: 5%">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Events.Any())
                    {
                        @foreach (var evt in Model.Events.OrderByDescending(e => e.CreatedAt))
                        {
                            var severityBadgeClass = evt.Severity switch
                            {
                                "Critical" => "danger",
                                "Error" => "danger",
                                "Warning" => "warning",
                                _ => "secondary"
                            };

                            <tr>
                                <td>
                                    <code>@evt.Id</code>
                                </td>
                                <td>
                                    <small>@evt.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(evt.UserEmail))
                                    {
                                        <small>@evt.UserEmail</small><br />
                                        <small class="text-muted">@evt.UserName</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">System</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@evt.Action</span>
                                </td>
                                <td>
                                    <small>@(evt.Description?.Substring(0, Math.Min(50, evt.Description?.Length ?? 0)) ?? "-")</small>
                                </td>
                                <td>
                                    <code>@(evt.IpAddress ?? "-")</code>
                                </td>
                                <td>
                                    <span class="badge bg-@severityBadgeClass">@(evt.Severity ?? "Info")</span>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "AuditLogs", new { id = evt.Id })" 
                                       class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fas fa-inbox"></i> No events found for this report
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Export Options -->
    <div class="mt-4 text-center">
        <button class="btn btn-sm btn-success" onclick="exportToCSV()">
            <i class="fas fa-download"></i> Export to CSV
        </button>
        <button class="btn btn-sm btn-primary" onclick="exportToPDF()">
            <i class="fas fa-file-pdf"></i> Export to PDF
        </button>
    </div>

    <!-- Footer -->
    <div class="mt-4 text-center text-muted small">
        <p>
            Report generated on @DateTime.Now.ToString("MMMM dd, yyyy \\a\\t HH:mm:ss") UTC<br/>
            This report contains sensitive security information. Handle with care.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function exportToCSV() {
            let csv = 'ID,Timestamp,User,Action,Description,IP,Severity\n';
            
            document.querySelectorAll('tbody tr').forEach(row => {
                let cols = row.querySelectorAll('td');
                if (cols.length > 0) {
                    csv += [
                        cols[0].innerText,
                        cols[1].innerText,
                        cols[2].innerText.replace(/\n/g, ' '),
                        cols[3].innerText,
                        cols[4].innerText,
                        cols[5].innerText,
                        cols[6].innerText
                    ].map(col => `"${col}"`).join(',') + '\n';
                }
            });

            let link = document.createElement('a');
            link.href = 'data:text/csv;charset=utf-8,' + encodeURI(csv);
            link.download = '@(Model.EventType.Replace(" ", "-").ToLower() + "-" + DateTime.Now.ToString("yyyy-MM-dd") + ".csv")';
            link.click();
        }

        function exportToPDF() {
            // Using browser print-to-PDF feature
            window.print();
        }
    </script>
}
