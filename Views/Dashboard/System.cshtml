@model JAS_MINE_IT15.Controllers.SystemDashboardViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "System Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .dash-wrap { padding: 14px 6px; }
    .stat-card {
        border: 1px solid #e6ebf2;
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(16,24,40,.06);
        background: #fff;
        padding: 20px;
        transition: transform .15s ease;
    }
    .stat-card:hover { transform: translateY(-2px); }
    .stat-card .stat-label { color: #6b778a; font-size: 14px; }
    .stat-card .stat-value { font-size: 32px; font-weight: 800; line-height: 1.1; margin-top: 6px; }

    .panel-card {
        border: 1px solid #e6ebf2;
        border-radius: 12px;
        box-shadow: 0 1px 2px rgba(16,24,40,.06);
        background: #fff;
        margin-bottom: 20px;
    }
    .panel-head { padding: 16px 18px 10px 18px; border-bottom: 1px solid #edf1f7; }
    .panel-title { font-weight: 800; font-size: 16px; margin: 0; display: flex; align-items: center; gap: 10px; }
    .panel-body { padding: 18px; }

    .activity-item { padding: 12px 0; border-bottom: 1px solid #edf1f7; }
    .activity-item:last-child { border-bottom: none; }
    .activity-icon {
        width: 36px; height: 36px; border-radius: 10px;
        display: inline-flex; align-items: center; justify-content: center;
        background: #f2f5f9;
    }

    .badge-pending { background: #fff8e5; color: #b58105; border: 1px solid #f5d96e; }
    .badge-success { background: #e8f8ef; color: #1e8449; border: 1px solid #7dcea0; }
    .badge-danger { background: #fdecea; color: #b71c1c; border: 1px solid #ef9a9a; }

    .revenue-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 12px;
        padding: 20px;
    }
    .revenue-card .rev-label { opacity: 0.8; font-size: 13px; }
    .revenue-card .rev-value { font-size: 24px; font-weight: 700; }

    .chart-bar {
        display: flex;
        align-items: flex-end;
        gap: 4px;
        height: 150px;
        padding: 0 4px;
    }
    .chart-bar-item {
        flex: 1;
        background: rgba(102, 126, 234, 0.7);
        border-radius: 4px 4px 0 0;
        min-height: 2px;
        position: relative;
        transition: background .2s;
    }
    .chart-bar-item:hover { background: #667eea; }
    .chart-bar-item .bar-label {
        position: absolute;
        bottom: -22px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 9px;
        color: #6b778a;
        white-space: nowrap;
    }
    .chart-bar-item .bar-value {
        position: absolute;
        top: -18px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 9px;
        color: #333;
        font-weight: 600;
        white-space: nowrap;
    }

    .table-report th { font-size: 13px; font-weight: 600; }
    .table-report td { font-size: 13px; }
</style>

@functions {
    private string Peso(decimal amount) => "₱" + string.Format("{0:N0}", amount);

    private string BadgeClass(string status) => status switch
    {
        "Active" or "Paid" or "Approved" => "bg-success-subtle text-success border border-success-subtle",
        "Expired" or "Overdue" => "bg-danger-subtle text-danger border border-danger-subtle",
        "Pending" or "PendingVerification" or "Unpaid" => "bg-warning-subtle text-warning border border-warning-subtle",
        "None" or "No Invoice" => "bg-secondary-subtle text-secondary border border-secondary-subtle",
        _ => "bg-secondary-subtle text-secondary"
    };
}

<div class="dash-wrap">
    <!-- ═══════ Top Stats (Super Admin relevant only) ═══════ -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card h-100">
                <div class="stat-label"><i class="bi bi-building me-1"></i> Total Barangays</div>
                <div class="stat-value text-primary">@Model.TotalBarangays</div>
                <small class="text-muted">@Model.ActiveBarangays active</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card h-100">
                <div class="stat-label"><i class="bi bi-people me-1"></i> Barangay Users</div>
                <div class="stat-value text-info">@Model.TotalUsers</div>
                <small class="text-muted">registered accounts</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card h-100">
                <div class="stat-label"><i class="bi bi-credit-card me-1"></i> Active Subscriptions</div>
                <div class="stat-value text-success">@Model.ActiveSubscriptions</div>
                <small class="text-muted">@Model.ExpiredSubscriptions expired</small>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card h-100">
                <div class="stat-label"><i class="bi bi-cash-stack me-1"></i> Total Revenue</div>
                <div class="stat-value text-warning">@Peso(Model.TotalRevenue)</div>
                <small class="text-muted">@Peso(Model.MonthlyRevenue) this month</small>
            </div>
        </div>
    </div>

    <!-- ═══════ Revenue Chart ═══════ -->
    <div class="panel-card mb-4">
        <div class="panel-head">
            <h5 class="panel-title"><i class="bi bi-bar-chart text-primary"></i> Monthly Revenue (Last 12 Months)</h5>
        </div>
        <div class="panel-body">
            @if (Model.MonthlyRevenueData.Any(m => m.Amount > 0))
            {
                var maxRevenue = Model.MonthlyRevenueData.Max(m => m.Amount);
                maxRevenue = maxRevenue > 0 ? maxRevenue : 1;

                <div class="chart-bar" style="margin-bottom: 28px;">
                    @foreach (var item in Model.MonthlyRevenueData)
                    {
                        var heightPercent = maxRevenue > 0 ? (double)(item.Amount / maxRevenue) * 100 : 0;
                        <div class="chart-bar-item" style="height: @(Math.Max(2, heightPercent))%;">
                            @if (item.Amount > 0)
                            {
                                <span class="bar-value">@Peso(item.Amount)</span>
                            }
                            <span class="bar-label">@item.Month.Substring(0, 3)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-bar-chart text-muted" style="font-size:48px; opacity:0.3;"></i>
                    <p class="text-muted mt-2 mb-0">No revenue data yet. Revenue will appear here once barangays complete their subscription payments.</p>
                </div>
            }
        </div>
    </div>

    <!-- ═══════ Barangay Activity Report ═══════ -->
    <div class="panel-card mb-4">
        <div class="panel-head d-flex align-items-center justify-content-between">
            <h5 class="panel-title"><i class="bi bi-building text-primary"></i> Barangay Activity Report</h5>
            <span class="badge bg-primary-subtle text-primary border">@Model.BarangaySummaries.Count barangay(s)</span>
        </div>
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-report align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Barangay</th>
                            <th class="text-center">Users</th>
                            <th class="text-center">Documents</th>
                            <th class="text-center">Policies</th>
                            <th class="text-center">Lessons</th>
                            <th class="text-center">Practices</th>
                            <th class="text-center">Announcements</th>
                            <th>Plan</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.BarangaySummaries.Any())
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">No barangays found.</td></tr>
                        }
                        @foreach (var b in Model.BarangaySummaries)
                        {
                            <tr>
                                <td class="fw-semibold">@b.BarangayName</td>
                                <td class="text-center">@b.TotalUsers</td>
                                <td class="text-center">@b.TotalDocuments</td>
                                <td class="text-center">@b.TotalPolicies</td>
                                <td class="text-center">@b.TotalLessonsLearned</td>
                                <td class="text-center">@b.TotalBestPractices</td>
                                <td class="text-center">@b.TotalAnnouncements</td>
                                <td>@b.PlanName</td>
                                <td><span class="badge @BadgeClass(b.SubscriptionStatus)">@b.SubscriptionStatus</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ═══════ Subscription Report ═══════ -->
    <div class="panel-card mb-4">
        <div class="panel-head d-flex align-items-center justify-content-between">
            <h5 class="panel-title"><i class="bi bi-credit-card-2-front text-success"></i> Subscription & Payment Report</h5>
            <span class="badge bg-success-subtle text-success border">@Model.SubscriptionReport.Count record(s)</span>
        </div>
        <div class="panel-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-report align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Barangay</th>
                            <th>Plan</th>
                            <th>Amount</th>
                            <th>Payment Status</th>
                            <th>Last Payment</th>
                            <th>Expiry Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.SubscriptionReport.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">No subscriptions found.</td></tr>
                        }
                        @foreach (var s in Model.SubscriptionReport)
                        {
                            <tr>
                                <td class="fw-semibold">@s.BarangayName</td>
                                <td>@s.PlanName</td>
                                <td class="fw-semibold">@Peso(s.Amount)</td>
                                <td><span class="badge @BadgeClass(s.PaymentStatus)">@s.PaymentStatus</span></td>
                                <td class="text-muted">@s.LastPaymentDate</td>
                                <td class="text-muted">@s.ExpiryDate</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ═══════ Inactive Barangays ═══════ -->
    @if (Model.InactiveBarangays.Any())
    {
        <div class="panel-card mb-4">
            <div class="panel-head d-flex align-items-center justify-content-between">
                <h5 class="panel-title"><i class="bi bi-exclamation-triangle text-danger"></i> Inactive Barangays</h5>
                <span class="badge bg-danger-subtle text-danger border">@Model.InactiveBarangays.Count inactive</span>
            </div>
            <div class="panel-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-report align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Barangay</th>
                                <th>Last Activity</th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.InactiveBarangays)
                            {
                                <tr>
                                    <td class="fw-semibold">@b.BarangayName</td>
                                    <td class="text-muted">@b.LastActivityDate</td>
                                    <td><span class="badge badge-danger">@b.Reason</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- ═══════ Recent Activity ═══════ -->
    <div class="panel-card">
        <div class="panel-head">
            <h5 class="panel-title"><i class="bi bi-activity text-info"></i> Recent System Activity</h5>
        </div>
        <div class="panel-body">
            @if (Model.RecentActivity.Any())
            {
                @foreach (var item in Model.RecentActivity)
                {
                    <div class="activity-item d-flex align-items-start gap-3">
                        <div class="activity-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@item.User <span class="text-muted fw-normal">@item.Action</span></div>
                            <small class="text-muted">@item.Module - @item.Target</small>
                        </div>
                        <small class="text-muted">@item.Timestamp</small>
                    </div>
                }
            }
            else
            {
                <p class="text-muted mb-0">No recent activity.</p>
            }
        </div>
    </div>
</div>
