@model JAS_MINE_IT15.Models.PagedResult<JAS_MINE_IT15.Services.UserActivityRow>
@{
    ViewData["Title"] = "User Activity Report";
    var fromDate = ViewData["FromDate"] as string ?? "";
    var toDate = ViewData["ToDate"] as string ?? "";
    var search = ViewData["Search"] as string ?? "";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="@Url.Action("DashboardHome", "Home")">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Reports")">Reports</a></li>
        <li class="breadcrumb-item active">User Activity</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-bold mb-0"><i class="bi bi-people me-2"></i>User Activity Report</h5>
    <a href="@Url.Action("ExportUserActivityCsv", new { from = fromDate, to = toDate })" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-download me-1"></i>Export CSV
    </a>
</div>

<!-- Filters -->
<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">From</label>
                <input type="date" name="from" class="form-control form-control-sm" value="@fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">To</label>
                <input type="date" name="to" class="form-control form-control-sm" value="@toDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Search</label>
                <input type="text" name="search" class="form-control form-control-sm" placeholder="Name or email…" value="@search" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-filter me-1"></i>Filter</button>
            </div>
        </div>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
        <p>No user activity found for the selected criteria.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th>Barangay</th>
                        <th class="text-center">Last Login</th>
                        <th class="text-center">Logins</th>
                        <th class="text-center">Docs</th>
                        <th class="text-center">Policies</th>
                        <th class="text-center">Lessons</th>
                        <th class="text-center">Discussions</th>
                        <th class="text-center fw-bold">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@u.FullName</div>
                                <div class="text-muted small">@u.Email</div>
                            </td>
                            <td><span class="badge bg-secondary">@u.Role</span></td>
                            <td class="small">@(u.BarangayName ?? "—")</td>
                            <td class="text-center small">@(u.LastLoginAt?.ToString("MMM dd, yyyy") ?? "Never")</td>
                            <td class="text-center">@u.LoginCount</td>
                            <td class="text-center">@u.DocumentsCreated</td>
                            <td class="text-center">@u.PoliciesCreated</td>
                            <td class="text-center">@u.LessonsCreated</td>
                            <td class="text-center">@u.DiscussionsCreated</td>
                            <td class="text-center fw-bold">@u.TotalContributions</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <partial name="_Pagination" />
    </div>
}
