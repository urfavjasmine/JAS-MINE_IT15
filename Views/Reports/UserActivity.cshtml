@model JAS_MINE_IT15.Models.PagedResult<JAS_MINE_IT15.Services.UserActivityRow>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "User Activity Report";
    var fromDate = ViewData["FromDate"] as string ?? "";
    var toDate = ViewData["ToDate"] as string ?? "";
    var search = ViewData["Search"] as string ?? "";

    // Aggregates for KPI cards (on current page for demo purposes)
    var totalLogins = Model.Items.Sum(i => i.LoginCount);
    var totalDocs = Model.Items.Sum(i => i.DocumentsCreated);
    var totalContributions = Model.Items.Sum(i => i.TotalContributions);
}

<style>
    :root {
        --brand-dark: #1a3a5c;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
    }

    .report-back { color: var(--brand-dark); text-decoration: none; font-size: 1.25rem; transition: transform 0.2s; }
    .report-back:hover { transform: translateX(-4px); }

    .report-header-section { display: flex; align-items: center; gap: 16px; margin-bottom: 2rem; }
    .report-title-group h1 { font-size: 1.5rem; font-weight: 800; color: var(--brand-dark); margin-bottom: 0.15rem; display: flex; align-items: center; gap: 10px; }
    .report-title-group p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0; }

    .filter-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: 2rem; }
    .btn-filter { border: 1px solid var(--border-color); background: #fff; color: var(--brand-dark); font-size: 0.825rem; font-weight: 600; padding: 6px 16px; border-radius: 6px; transition: all 0.2s; }
    .btn-filter:hover { background: #f8fafc; border-color: #cbd5e1; }
    .btn-filter.active { background: #f1f5f9; border-color: #1a3a5c; color: #1a3a5c; }

    .date-range-group { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--border-color); padding: 4px 12px; border-radius: 6px; }
    .date-range-group input { border: none; font-size: 0.825rem; font-weight: 600; color: var(--brand-dark); width: 100px; background: transparent; }
    .date-range-group input:focus { outline: none; }

    .export-btns { margin-left: auto; display: flex; gap: 8px; }
    .btn-export { display: flex; align-items: center; gap: 6px; background: #fff; border: 1px solid var(--border-color); color: var(--brand-dark); font-size: 0.825rem; font-weight: 600; padding: 6px 14px; border-radius: 6px; }

    .kpi-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 2rem; }
    .kpi-card { background: #fff; border: 1px solid var(--border-color); border-radius: 10px; padding: 20px; position: relative; }
    .kpi-lbl { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 4px; }
    .kpi-val { font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-bottom: 4px; }
    .kpi-trend { font-size: 0.7rem; font-weight: 700; color: #10b981; display: flex; align-items: center; gap: 4px; }
    .kpi-icon-box { position: absolute; top: 20px; right: 20px; width: 36px; height: 36px; background: #f8fafc; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #94a3b8; }

    .chart-card { background: #fff; border: 1px solid var(--border-color); border-radius: 10px; padding: 24px; margin-bottom: 2rem; }
    .chart-title { font-size: 0.95rem; font-weight: 700; color: #334155; margin-bottom: 1.5rem; }

    .report-table-card { background: #fff; border: 1px solid var(--border-color); border-radius: 10px; overflow: hidden; }
    .table-reports thead th { background: #fcfdfe; border-bottom: 1px solid var(--border-color); padding: 14px 20px; color: var(--text-muted); font-size: 0.825rem; font-weight: 600; text-transform: uppercase; }
    .table-reports tbody td { padding: 16px 20px; font-size: 0.925rem; color: #334155; border-bottom: 1px solid #f1f5f9; }
    .user-info .name { font-weight: 700; color: #1e293b; }
    .user-info .email { font-size: 0.825rem; color: var(--text-muted); }
    .role-badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; background: #f1f5f9; color: #475569; }
</style>

<div class="report-header-section">
    <a href="@Url.Action("Index")" class="report-back">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div class="report-title-group">
        <h1><i class="bi bi-person-workspace"></i> User Activity Report</h1>
        <p>Login frequency, contributions, and engagement metrics per user.</p>
    </div>
</div>

<div class="filter-bar">
    <form method="get" id="filterForm" class="d-flex flex-wrap align-items-center gap-2">
        <input type="hidden" name="search" value="@search" />
        <button type="submit" name="range" value="7" class="btn-filter @(ViewData["Range"] as string == "7" ? "active" : "")">Last 7 days</button>
        <button type="submit" name="range" value="30" class="btn-filter @(ViewData["Range"] as string == "30" || string.IsNullOrEmpty(ViewData["Range"] as string) ? "active" : "")">Last 30 days</button>
        <button type="submit" name="range" value="thismonth" class="btn-filter @(ViewData["Range"] as string == "thismonth" ? "active" : "")">This month</button>
        <button type="submit" name="range" value="90" class="btn-filter @(ViewData["Range"] as string == "90" ? "active" : "")">Last 3 months</button>
        <button type="submit" name="range" value="180" class="btn-filter @(ViewData["Range"] as string == "180" ? "active" : "")">Last 6 months</button>
        <button type="submit" name="range" value="365" class="btn-filter @(ViewData["Range"] as string == "365" ? "active" : "")">Last year</button>

        <div class="date-range-group">
            <i class="bi bi-calendar3 text-muted"></i>
            <input type="date" name="from" value="@fromDate" />
            <span class="text-muted small">—</span>
            <input type="date" name="to" value="@toDate" />
            <button type="submit" class="btn btn-sm btn-primary ms-2">Apply</button>
        </div>
    </form>

    <div class="export-btns">
        <a href="@Url.Action("ExportUserActivityCsv", new { from = fromDate, to = toDate })" class="btn-export">
            <i class="bi bi-download"></i> CSV
        </a>
        <button class="btn-export">
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </button>
    </div>
</div>

<div class="kpi-row">
    <div class="kpi-card">
        <div class="kpi-lbl">Total Logins</div>
        <div class="kpi-val">@totalLogins</div>
        <div class="kpi-trend text-success"><i class="bi bi-arrow-up"></i> +15% <span class="text-muted fw-normal" style="font-size:0.65rem;">from last period</span></div>
        <div class="kpi-icon-box"><i class="bi bi-box-arrow-in-right"></i></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-lbl">Documents Uploaded</div>
        <div class="kpi-val">@totalDocs</div>
        <div class="kpi-trend text-success"><i class="bi bi-arrow-up"></i> +8% <span class="text-muted fw-normal" style="font-size:0.65rem;">from last period</span></div>
        <div class="kpi-icon-box"><i class="bi bi-file-earmark-arrow-up"></i></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-lbl">Contributions</div>
        <div class="kpi-val">@totalContributions</div>
        <div class="kpi-trend text-success"><i class="bi bi-arrow-up"></i> +12% <span class="text-muted fw-normal" style="font-size:0.65rem;">from last period</span></div>
        <div class="kpi-icon-box"><i class="bi bi-plus-circle"></i></div>
    </div>
</div>

<div class="chart-card">
    <div class="chart-title">Login & Contribution Trend (Weekly)</div>
    <div style="height: 300px;">
        <canvas id="activityChart"></canvas>
    </div>
</div>

<div class="report-table-card">
    <div class="table-responsive">
        <table class="table table-reports align-middle">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th class="text-center">Logins</th>
                    <th class="text-center">Documents</th>
                    <th class="text-center">Policies</th>
                    <th class="text-center">Lessons</th>
                    <th class="text-center">Last Login</th>
                    <th class="text-center">Avg Session</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="user-info">
                                <div class="name">@u.FullName</div>
                                <div class="email">@u.Email</div>
                            </div>
                        </td>
                        <td><span class="role-badge">@u.Role.Replace("_", " ")</span></td>
                        <td class="text-center fw-semibold">@u.LoginCount</td>
                        <td class="text-center">@u.DocumentsCreated</td>
                        <td class="text-center">@u.PoliciesCreated</td>
                        <td class="text-center">@u.LessonsCreated</td>
                        <td class="text-center text-muted small">@(u.LastLoginAt?.ToString("yyyy-MM-dd") ?? "Never")</td>
                        <td class="text-center text-muted small">18 min</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Items.Count > 0)
{
    <div class="mt-4">
        <partial name="_Pagination" />
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('activityChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['W1', 'W2', 'W3', 'W4', 'W5', 'W6'],
                datasets: [{
                    label: 'Logins',
                    data: [120, 128, 125, 132, 138, 135],
                    borderColor: '#1e6cbd',
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#1e6cbd'
                }, {
                    label: 'Contributions',
                    data: [82, 85, 83, 88, 91, 86],
                    borderColor: '#10b981',
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#10b981'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: { color: '#94a3b8', font: { size: 11 } }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { color: '#94a3b8', font: { size: 11 } }
                    }
                }
            }
        });
    </script>
}
