@model List<JAS_MINE_IT15.Services.ChurnDataPoint>
@{
    ViewData["Title"] = "Subscription Churn";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="@Url.Action("DashboardHome", "Home")">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Reports")">Reports</a></li>
        <li class="breadcrumb-item active">Subscription Churn</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-bold mb-0"><i class="bi bi-arrow-down-circle me-2"></i>Subscription Churn Report</h5>
    <a href="@Url.Action("ExportChurnCsv")" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-download me-1"></i>Export CSV
    </a>
</div>

<!-- Summary -->
@{
    var totalChurned = Model.Sum(m => m.Churned);
    var avgRate = Model.Where(m => m.ChurnRate > 0).DefaultIfEmpty().Average(m => m?.ChurnRate ?? 0);
    var latestActive = Model.LastOrDefault()?.Active ?? 0;
}
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="fs-3 fw-bold text-danger">@totalChurned</div>
                <div class="text-muted small">Total Churned (12 mo)</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="fs-3 fw-bold text-warning">@avgRate.ToString("N1")%</div>
                <div class="text-muted small">Avg Monthly Churn Rate</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body">
                <div class="fs-3 fw-bold text-success">@latestActive</div>
                <div class="text-muted small">Currently Active</div>
            </div>
        </div>
    </div>
</div>

<!-- Chart -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-bold">Monthly Churn vs Active</div>
    <div class="card-body">
        <canvas id="churnChart" height="120"></canvas>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Month</th>
                    <th class="text-center">Active</th>
                    <th class="text-center">Churned</th>
                    <th class="text-center">Churn Rate</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.AsEnumerable().Reverse())
                {
                    <tr>
                        <td>@r.Month</td>
                        <td class="text-center text-success fw-semibold">@r.Active</td>
                        <td class="text-center text-danger fw-semibold">@r.Churned</td>
                        <td class="text-center">
                            @if (r.ChurnRate > 5)
                            {
                                <span class="badge bg-danger">@r.ChurnRate%</span>
                            }
                            else if (r.ChurnRate > 0)
                            {
                                <span class="badge bg-warning text-dark">@r.ChurnRate%</span>
                            }
                            else
                            {
                                <span class="badge bg-success">0%</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Month)));
        const active = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Active)));
        const churned = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Churned)));

        new Chart(document.getElementById('churnChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Active',
                        data: active,
                        backgroundColor: 'rgba(25,135,84,.6)',
                        borderRadius: 4
                    },
                    {
                        label: 'Churned',
                        data: churned,
                        backgroundColor: 'rgba(220,53,69,.6)',
                        borderRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}
