@model List<JAS_MINE_IT15.Services.BarangayReportSummary>
@{
    ViewData["Title"] = "Barangay Summary Report";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="@Url.Action("DashboardHome", "Home")">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Reports")">Reports</a></li>
        <li class="breadcrumb-item active">Barangay Summary</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0"><i class="bi bi-geo-alt me-2"></i>Per-Barangay Drill-Down</h5>
    <a href="@Url.Action("ExportBarangaySummaryCsv")" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-download me-1"></i>Export CSV
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
        <p>No barangays registered yet.</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Barangay</th>
                    <th class="text-center">Users</th>
                    <th class="text-center">Documents</th>
                    <th class="text-center">Policies</th>
                    <th class="text-center">Lessons</th>
                    <th class="text-center">Best Practices</th>
                    <th class="text-center">Discussions</th>
                    <th>Subscription</th>
                    <th>Plan</th>
                    <th>Expiry</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var statusClass = r.SubscriptionStatus switch
                    {
                        "Active" => "bg-success",
                        "Expired" => "bg-danger",
                        "Cancelled" => "bg-secondary",
                        _ => "bg-warning"
                    };
                    <tr>
                        <td class="fw-semibold">@r.BarangayName</td>
                        <td class="text-center">@r.TotalUsers</td>
                        <td class="text-center">@r.TotalDocuments</td>
                        <td class="text-center">@r.TotalPolicies</td>
                        <td class="text-center">@r.TotalLessons</td>
                        <td class="text-center">@r.TotalBestPractices</td>
                        <td class="text-center">@r.TotalDiscussions</td>
                        <td><span class="badge @statusClass">@r.SubscriptionStatus</span></td>
                        <td>@r.PlanName</td>
                        <td class="small text-muted">@(r.SubscriptionExpiry?.ToString("MMM dd, yyyy") ?? "—")</td>
                        <td>
                            <a href="@Url.Action("BarangayDetail", new { id = r.BarangayId })" class="btn btn-sm btn-outline-primary" title="Detail">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
