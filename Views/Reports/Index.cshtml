@model JAS_MINE_IT15.Services.ReportDashboardCounts
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Reports & Analytics";
    var role = Context.Session.GetString("Role") ?? "";
}

<style>
    :root {
        --brand-dark: #1a3a5c;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --card-bg: #fcfdfe;
    }

    .report-page-header {
        margin-bottom: 2.5rem;
    }

    .report-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--brand-dark);
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 0.25rem;
    }

    .report-subtitle {
        color: var(--text-muted);
        font-size: 1rem;
    }

    .report-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 24px;
        height: 100%;
        transition: all 0.2s ease-in-out;
        display: flex;
        flex-direction: column;
    }

    .report-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.04);
        border-color: #cbd5e1;
    }

    .report-card-icon {
        width: 42px;
        height: 42px;
        background: #f8fafc;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: var(--brand-dark);
        margin-bottom: 1.25rem;
    }

    .report-card-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin-bottom: 0.75rem;
    }

    .report-card-desc {
        color: var(--text-muted);
        font-size: 0.925rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
        flex-grow: 1;
    }

    .report-card-link {
        font-size: 0.95rem;
        font-weight: 600;
        color: #1e6cbd;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: gap 0.2s;
    }

    .report-card-link:hover {
        gap: 12px;
        color: #0f6cbd;
    }
</style>

<div class="report-page-header">
    <h1 class="report-title">
        <i class="bi bi-bar-chart-line"></i> Reports & Analytics
    </h1>
    <p class="report-subtitle">Comprehensive reporting suite for data-driven insights.</p>
</div>

<div class="row g-4">
    <!-- User Activity Report -->
    <div class="col-md-6 col-lg-4">
        <div class="report-card">
            <div class="report-card-icon">
                <i class="bi bi-person-workspace"></i>
            </div>
            <h3 class="report-card-title">User Activity Report</h3>
            <p class="report-card-desc">Login frequency, contributions, and engagement metrics per user.</p>
            <a href="@Url.Action("UserActivity")" class="report-card-link">
                View Report <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- Document & Policy Lifecycle -->
    <div class="col-md-6 col-lg-4">
        <div class="report-card">
            <div class="report-card-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>
            <h3 class="report-card-title">Document & Policy Lifecycle</h3>
            <p class="report-card-desc">Track documents and policies from creation through approval and archival.</p>
            <a href="@Url.Action("ContentLifecycle")" class="report-card-link">
                View Report <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    @if (role == "super_admin")
    {
        <!-- Revenue Trend Report -->
        <div class="col-md-6 col-lg-4">
            <div class="report-card">
                <div class="report-card-icon">
                    <i class="bi bi-graph-up"></i>
                </div>
                <h3 class="report-card-title">Revenue Trend Report</h3>
                <p class="report-card-desc">Month-over-month revenue growth, plan distribution, and projections.</p>
                <a href="@Url.Action("RevenueTrends")" class="report-card-link">
                    View Report <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>

        <!-- Subscription Churn Report -->
        <div class="col-md-6 col-lg-4">
            <div class="report-card">
                <div class="report-card-icon">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <h3 class="report-card-title">Subscription Churn Report</h3>
                <p class="report-card-desc">Churn rate analysis, cancellation reasons, and retention metrics.</p>
                <a href="@Url.Action("SubscriptionChurn")" class="report-card-link">
                    View Report <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    }
</div>
