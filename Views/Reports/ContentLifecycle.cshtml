@model List<JAS_MINE_IT15.Services.ContentLifecycleRow>
@{
    ViewData["Title"] = "Content Lifecycle Report";
    var fromDate = ViewData["FromDate"] as string ?? "";
    var toDate = ViewData["ToDate"] as string ?? "";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="@Url.Action("DashboardHome", "Home")">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Reports")">Reports</a></li>
        <li class="breadcrumb-item active">Content Lifecycle</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="fw-bold mb-0"><i class="bi bi-arrow-repeat me-2"></i>Content Lifecycle Report</h5>
    <a href="@Url.Action("ExportContentLifecycleCsv", new { from = fromDate, to = toDate })" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-download me-1"></i>Export CSV
    </a>
</div>

<!-- Date Filters -->
<form method="get" class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold">From</label>
                <input type="date" name="from" class="form-control form-control-sm" value="@fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">To</label>
                <input type="date" name="to" class="form-control form-control-sm" value="@toDate" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-filter me-1"></i>Filter</button>
            </div>
        </div>
    </div>
</form>

<!-- Status Distribution Table -->
<div class="card border-0 shadow-sm mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Module</th>
                    <th class="text-center">Draft</th>
                    <th class="text-center">Pending</th>
                    <th class="text-center">Approved</th>
                    <th class="text-center">Rejected</th>
                    <th class="text-center">Archived</th>
                    <th class="text-center fw-bold">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-semibold">@r.Module</td>
                        <td class="text-center"><span class="badge bg-secondary">@r.Draft</span></td>
                        <td class="text-center"><span class="badge bg-warning text-dark">@r.Pending</span></td>
                        <td class="text-center"><span class="badge bg-success">@r.Approved</span></td>
                        <td class="text-center"><span class="badge bg-danger">@r.Rejected</span></td>
                        <td class="text-center"><span class="badge bg-dark">@r.Archived</span></td>
                        <td class="text-center fw-bold">@r.Total</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Stacked Bar Chart -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold">Status Distribution</div>
    <div class="card-body">
        <canvas id="lifecycleChart" height="100"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const modules = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Module)));
        const draft = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Draft)));
        const pending = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Pending)));
        const approved = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Approved)));
        const rejected = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Rejected)));
        const archived = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(m => m.Archived)));

        new Chart(document.getElementById('lifecycleChart'), {
            type: 'bar',
            data: {
                labels: modules,
                datasets: [
                    { label: 'Draft', data: draft, backgroundColor: '#6c757d' },
                    { label: 'Pending', data: pending, backgroundColor: '#ffc107' },
                    { label: 'Approved', data: approved, backgroundColor: '#198754' },
                    { label: 'Rejected', data: rejected, backgroundColor: '#dc3545' },
                    { label: 'Archived', data: archived, backgroundColor: '#212529' }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    x: { stacked: true },
                    y: { stacked: true, beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });
    </script>
}
